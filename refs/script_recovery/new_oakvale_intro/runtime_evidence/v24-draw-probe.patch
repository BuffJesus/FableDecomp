+// Retail CDrawScreenFade::Draw is __thiscall with one argument (ret 4).
+// Count entry/return only: no logging, engine queries, or state writes on the draw path.
+typedef void(__thiscall* tDiagDrawScreenFade)(void*, void*);
+static tDiagDrawScreenFade DiagDrawScreenFade_Original = nullptr;
+static volatile LONG g_fadeDrawEntered = 0, g_fadeDrawReturned = 0;
+static volatile LONG g_fadeDrawObject = 0, g_fadeDrawTick = 0;
+static void __fastcall DiagDrawScreenFade_Detour(void* self, void*, void* prepareInfo) {
+    InterlockedExchange(&g_fadeDrawObject, reinterpret_cast<LONG>(self));
+    InterlockedExchange(&g_fadeDrawTick, static_cast<LONG>(GetTickCount()));
+    InterlockedIncrement(&g_fadeDrawEntered);
+    DiagDrawScreenFade_Original(self, prepareInfo);
+    InterlockedIncrement(&g_fadeDrawReturned);
+}
+static __declspec(naked) void DiagDrawScreenFade_NakedStub() {
+    __asm { jmp DiagDrawScreenFade_Detour }
+}
