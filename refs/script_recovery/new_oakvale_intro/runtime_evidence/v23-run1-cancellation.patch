     auto questState_type = lua.new_usertype<LuaQuestState>("Quest", sol::no_constructor);
 
     questState_type["NewScriptFrame"] = sol::overload(sol::resolve<bool()>(&LuaQuestState::NewScriptFrame),sol::resolve<bool(CScriptThing*)>(&LuaQuestState::NewScriptFrame));
-    questState_type["IsActiveThreadTerminating"] = &LuaQuestState::IsActiveThreadTerminating;
+    // Each entity VM is registered with its actual host. Retail entity callers
+    // test that host (0x00F35B30), not the owning quest's termination predicate.
+    // This query does not advance a frame or treat cutscene skip as termination.
+    questState_type["IsActiveThreadTerminating"] = [pEntityHost](LuaQuestState& self) {
+        if (pEntityHost) {
+            return IsActiveThreadTerminating_Entity_API &&
+                IsActiveThreadTerminating_Entity_API(pEntityHost);
+        }
+        return self.IsActiveThreadTerminating();
+    };
     questState_type["Log"] = &LuaQuestState::Log;
     questState_type["GetFSEInfo"] = &LuaQuestState::GetFSEInfo;
     questState_type["CreateThread"] = sol::overload([](LuaQuestState& self, const std::string& func) {self.CreateThread(func, sol::lua_nil); }, [](LuaQuestState& self, const std::string& func, sol::table args) {self.CreateThread(func, args); });
