  "texts": {
    "TEXT_QST_077_MAZE_INTRO_05": {
      "content": "So you really found your sister.  I would never have imagined her living among Bandits.",
      "speechbank": "ScriptDialogue.lug",
      "speaker": "MAZE",
      "identifier": "TEXT_QST_077_MAZE_INTRO_05",
      "tags": [],
      "speaker_index": 16,
      "id": 3852,
      "type": 0,
      "name": "TEXT_QST_077_MAZE_INTRO_05",
      "payload_sha256": "3259a7ebe79f2745b9e65e5ab79e3cbc0212def409b45187b9809c99e999d5c3"
    },
    "TEXT_QST_077_MAZE_INTRO_10": {
      "content": "You've really come a long way these last few years, haven't you?",
      "speechbank": "ScriptDialogue.lug",
      "speaker": "MAZE",
      "identifier": "TEXT_QST_077_MAZE_INTRO_10",
      "tags": [],
      "speaker_index": 16,
      "id": 3825,
      "type": 0,
      "name": "TEXT_QST_077_MAZE_INTRO_10",
      "payload_sha256": "d3b345f48c34e7cc300b408b7859a9fd25b9121956784aed0e59d7102b671f2b"
    },
    "TEXT_QST_077_MAZE_INTRO_100": {
      "content": "There's a rumour he may be hiding somewhere in Witchwood. That is, if he isn't dead already.",
      "speechbank": "ScriptDialogue.lug",
      "speaker": "MAZE",
      "identifier": "TEXT_QST_077_MAZE_INTRO_100",
      "tags": [],
      "speaker_index": 16,
      "id": 4083,
      "type": 0,
      "name": "TEXT_QST_077_MAZE_INTRO_100",
      "payload_sha256": "21c6ce8c6e8fe06dd4fe253ba3887aedc3b3f68d62d876cddecb710a58aa8e58"
    },
    "TEXT_QST_077_MAZE_INTRO_110": {
      "content": "You can use a Cullis Gate to get there. I only hope it isn't too late.",
      "speechbank": "ScriptDialogue.lug",
      "speaker": "MAZE",
      "identifier": "TEXT_QST_077_MAZE_INTRO_110",
      "tags": [],
      "speaker_index": 16,
      "id": 4088,
      "type": 0,
      "name": "TEXT_QST_077_MAZE_INTRO_110",
      "payload_sha256": "4b11aafa99a402f7018a70387b8f3e4bb3fb640a1c879f51f29274b743d549af"
    },
    "TEXT_QST_077_MAZE_INTRO_20": {
      "content": "People are starting to ask when they'll see you in the Arena out in Witchwood.",
      "speechbank": "ScriptDialogue.lug",
      "speaker": "MAZE",
      "identifier": "TEXT_QST_077_MAZE_INTRO_20",
      "tags": [],
      "speaker_index": 16,
      "id": 3834,
      "type": 0,
      "name": "TEXT_QST_077_MAZE_INTRO_20",
      "payload_sha256": "c9af0f15dc57868f979989110772355a10af147e6349b6fa40d9d7340ea23d82"
    },
    "TEXT_QST_077_MAZE_INTRO_60": {
      "content": "But before you go wandering again. I've left a Quest Card of my own. A favour, if you will.",
      "speechbank": "ScriptDialogue.lug",
      "speaker": "MAZE",
      "identifier": "TEXT_QST_077_MAZE_INTRO_60",
      "tags": [],
      "speaker_index": 16,
      "id": 3830,
      "type": 0,
      "name": "TEXT_QST_077_MAZE_INTRO_60",
      "payload_sha256": "f99f60ee62c9438e635435447d5b0a195fb3d5d878b6e8ce1870015c3496f896"
    },
    "TEXT_QST_077_MAZE_INTRO_70": {
      "content": "An old friend of mine has gone missing. Calls himself the Archaeologist.",
      "speechbank": "ScriptDialogue.lug",
      "speaker": "MAZE",
      "identifier": "TEXT_QST_077_MAZE_INTRO_70",
      "tags": [],
      "speaker_index": 16,
      "id": 3861,
      "type": 0,
      "name": "TEXT_QST_077_MAZE_INTRO_70",
      "payload_sha256": "48d5d1c7569bd14d4b84299625325bc7a934268d7207f557811fb52233bc160b"
    },
    "TEXT_QST_077_MAZE_INTRO_90": {
      "content": "He may have stumbled on to something big. Perhaps big enough to put his life in danger.",
      "speechbank": "ScriptDialogue.lug",
      "speaker": "MAZE",
      "identifier": "TEXT_QST_077_MAZE_INTRO_90",
      "tags": [],
      "speaker_index": 16,
      "id": 3856,
      "type": 0,
      "name": "TEXT_QST_077_MAZE_INTRO_90",
      "payload_sha256": "621250d533b1dba9055489775d32d2a4e44b712101c21ab27753d8a35947513d"
    },
    "TEXT_QST_077_MAZE_ON_HIT": {
      "content": "Ah, Hero. Your enthusiasm for the battle is exemplary, if sometimes misplaced.",
      "speechbank": "ScriptDialogue.lug",
      "speaker": "MAZE",
      "identifier": "TEXT_QST_077_MAZE_ON_HIT",
      "tags": [],
      "speaker_index": 16,
      "id": 3261,
      "type": 0,
      "name": "TEXT_QST_077_MAZE_ON_HIT",
      "payload_sha256": "0ef7e2c98e3d357feb03187893e9e2b85b6b6c8c883df9248089cc413e53ddbc"
    },
    "TEXT_QST_077_MAZE_REPEAT": {
      "content": "Still here? Go and look for the Archaeologist.",
      "speechbank": "ScriptDialogue.lug",
      "speaker": "MAZE",
      "identifier": "TEXT_QST_077_MAZE_REPEAT",
      "tags": [],
      "speaker_index": 16,
      "id": 3182,
      "type": 0,
      "name": "TEXT_QST_077_MAZE_REPEAT",
      "payload_sha256": "2b27eb8d142d06f49e55f05bdd372336ea893b4d6f35965cf4e4925f9c39af19"
    },
    "TEXT_QUEST_GUARDIAN_TROPHY_DEALER_INFO_OBJECTIVE_01": {
      "content": "Meet Maze in his quarters at the Guild.",
      "speechbank": "",
      "speaker": "",
      "identifier": "TEXT_QUEST_GUARDIAN_TROPHY_DEALER_INFO_OBJECTIVE_01",
      "tags": [],
