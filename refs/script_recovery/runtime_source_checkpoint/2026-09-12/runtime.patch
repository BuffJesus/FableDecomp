+typedef int(__thiscall* tDiagFindCharPos)(const CCharString*, char);
+typedef bool(__cdecl* tDiagIsCutsceneSkipped)();
+static tDiagFindCharPos DiagFindCharPos_Original = nullptr;
+static tDiagIsCutsceneSkipped DiagIsCutsceneSkipped_Original = nullptr;
+
+// Passive snapshots, not engine queries: IsCutsceneSkipped consumes a message and
+// must never be called merely to inspect state. Retail byte proof is recorded in
+// runtime_evidence/cutscene-fade-native-analysis-20260912.md.
+static void LogCutsceneFadeSnapshot(const char* command) {
+    uintptr_t gsi = 0, display = 0;
+    unsigned char interfaceBytes[0x30] = {}, displayBytes[0xFC] = {};
+    SIZE_T bytes = 0;
+    const HANDLE process = GetCurrentProcess();
+    const bool readable = ReadProcessMemory(process, ASLR<void*>(0x0143E8F8), &gsi, sizeof(gsi), &bytes)
+        && gsi && ReadProcessMemory(process, reinterpret_cast<void*>(gsi), interfaceBytes, sizeof(interfaceBytes), &bytes);
+    if (readable) memcpy(&display, interfaceBytes + 0xC, sizeof(display));
+    const bool displayReadable = readable && display && ReadProcessMemory(process,
+        reinterpret_cast<void*>(display), displayBytes, sizeof(displayBytes), &bytes);
+    std::ostringstream ss;
+    ss << "[CutsceneFadeDiag] tick=" << GetTickCount() << " gsi=0x" << std::hex << gsi
+       << " display=0x" << display << std::dec << " readable=" << (displayReadable ? 1 : 0);
+    if (displayReadable) {
+        float outTime = 0, inTime = 0, outElapsed = 0, inRemaining = 0;
+        unsigned colour = 0, freezeCount = 0;
+        memcpy(&outTime, displayBytes + 0xC0, 4);
+        memcpy(&inTime, displayBytes + 0xC4, 4);
+        memcpy(&outElapsed, displayBytes + 0xCC, 4);
+        memcpy(&inRemaining, displayBytes + 0xD0, 4);
+        memcpy(&colour, displayBytes + 0xD4, 4);
+        memcpy(&freezeCount, displayBytes + 0xE8, 4);
+        ss << " active=" << unsigned(displayBytes[0xBC])
+           << " fadingIn=" << unsigned(displayBytes[0xC8])
+           << " fadingOut=" << unsigned(displayBytes[0xC9])
+           << " holdUntilIn=" << unsigned(displayBytes[0xD8])
+           << " allowOverride=" << unsigned(interfaceBytes[0x2D])
+           << " outTime=" << outTime << " inTime=" << inTime
+           << " outElapsed=" << outElapsed << " inRemaining=" << inRemaining
+           << " colour=0x" << std::hex << colour << std::dec
+           << " freezeCount=" << freezeCount;
+    }
+    ss << " beforeCommand=" << (command ? command : "<null>");
+    LogToFile(ss.str());
+}
+
+// The interpreter's first FindCharPos call receives the complete current command.
+// Restrict to its proven return address: ordinary string calls are only forwarded.
+static int __fastcall DiagFindCharPos_Detour(const CCharString* command, void*, char needle) {
+    if (reinterpret_cast<uintptr_t>(_ReturnAddress()) == ASLR<uintptr_t>(0x00CC023C)) {
+        const char* text = CCharString_ToConstChar_API ? CCharString_ToConstChar_API(command) : nullptr;
+        std::ostringstream ss;
+        ss << "[CutsceneCommandDiag] macro="
+           << (g_cutsceneSkipDiagMacro ? g_cutsceneSkipDiagMacro : "<none>")
+           << " tick=" << GetTickCount() << " command=" << (text ? text : "<null>");
+        LogToFile(ss.str());
+        LogCutsceneFadeSnapshot(text);
+    }
+    return DiagFindCharPos_Original(command, needle);
+}
+static __declspec(naked) void DiagFindCharPos_NakedStub() {
+    __asm { jmp DiagFindCharPos_Detour }
+}
+
+static bool __cdecl DiagIsCutsceneSkipped_Detour() {
+    const uintptr_t caller = reinterpret_cast<uintptr_t>(_ReturnAddress());
+    // This can consume a script message: call exactly once and preserve the result.
+    const bool skipped = DiagIsCutsceneSkipped_Original();
+    if (skipped) {
+        std::ostringstream ss;
+        ss << "[CutsceneCommandDiag] skipQueryTrue macro="
+           << (g_cutsceneSkipDiagMacro ? g_cutsceneSkipDiagMacro : "<none>")
+           << " caller=0x" << std::hex << caller << std::dec << " tick=" << GetTickCount();
+        LogToFile(ss.str());
+    }
+    return skipped;
+}
+static __declspec(naked) void DiagIsCutsceneSkipped_NakedStub() {
+    __asm { jmp DiagIsCutsceneSkipped_Detour }
+}
+
+static void InstallCutsceneCommandDiagnostics() {
+    if (g_cutsceneCommandDiagHooksInstalled) return;
+    const DWORD find = ASLR<DWORD>(0x0099E5A0);
+    const DWORD skipped = ASLR<DWORD>(0x00CBEB7E);
+    const BYTE findExpected[5] = {0x56, 0x8b, 0xf1, 0x8b, 0x06};
+    // cmp byte ptr [ASLR(0x0143E8F4)],0: seven bytes, no relative branch.
+    BYTE skipExpected[7] = {0x80, 0x3d, 0, 0, 0, 0, 0};
+    const DWORD modeAddress = ASLR<DWORD>(0x0143E8F4);
+    memcpy(skipExpected + 2, &modeAddress, sizeof(modeAddress));
+    if (memcmp(reinterpret_cast<const void*>(find), findExpected, sizeof(findExpected)) ||
+        memcmp(reinterpret_cast<const void*>(skipped), skipExpected, sizeof(skipExpected))) {
+        LogToFile("!!! [CutsceneCommandDiag] prologue mismatch; command hooks not installed.");
+        return;
+    }
+    const bool a = InstallInlineHook(find, &DiagFindCharPos_NakedStub, sizeof(findExpected),
+        reinterpret_cast<void**>(&DiagFindCharPos_Original), "CutsceneCommand.FindCharPos");
+    const bool b = InstallInlineHook(skipped, &DiagIsCutsceneSkipped_NakedStub, sizeof(skipExpected),
+        reinterpret_cast<void**>(&DiagIsCutsceneSkipped_Original), "CutsceneCommand.IsCutsceneSkipped");
+    g_cutsceneCommandDiagHooksInstalled = a && b;
+    LogToFile(g_cutsceneCommandDiagHooksInstalled
+        ? "[CutsceneCommandDiag] passive command and skip-query hooks installed."
+        : "!!! [CutsceneCommandDiag] command hook installation incomplete.");
+}
