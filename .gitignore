# IDE and local configuration
.idea/
.vscode/
imgui.ini
*.user
*.suo

# Proprietary/local binary inputs and analysis databases
/debug_build/
/symbols/
/ghidra_proj/
/bsim/
/unified_build/
/work/
/dist/
/tmp/
/snapshots/
/FSE/
/FableTLC_RE_docs.zip
/refs/*.pdf
/refs/*.log

# Multi-gigabyte generated PDB XML. Compact symbol/name/layout exports remain tracked.
/ghidra_out/*_pdb.xml
/ghidra_out/**/*.log
/ghidra_out/**/*.pkl

# Generated build products and caches
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.cache/
**/bin/Debug/
**/bin/Release/
**/obj/Debug/
**/obj/Release/
**/*.obj
**/*.exe
**/*.dll
**/*.pdb
**/*.ilk
**/*.idb
**/*.dmp
**/*.tmp
**/*.pid

# Curated rebuild outputs are reproducible from source.
/rebuild/build/
/rebuild/local-parity/
/rebuild/refresh.log
/rebuild/refresh.state.json
# Candidate snapshots duplicate reviewed report inputs and are regenerated by the gate.
/rebuild/candidates/snapshots/
# Local parity-fix verification scratch (isolated compiles, not the shared build catalog).
/rebuild/corrections/_verify/

# RE-agent transcripts/state are local and continuously changing; keep source/config/results.
/lift/logs/
/lift/reports/*/logs/
/lift/state/*.log
/lift/state/*.pid
/lift/state/*.stop
/lift/state/*.tmp
/lift/proofs/build/

# Blender proof products generated from game assets.
/tools/blender_addon/tests/**/*.blend
/tools/blender_addon/tests/**/*.blend1
/tools/blender_addon/tests/proof/*.png
