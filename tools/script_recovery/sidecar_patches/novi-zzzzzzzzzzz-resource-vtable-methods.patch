+    // The rest of CScriptGameResourceObjectScriptedThingBaseVTable, for quest scripts that call entity methods on a
+    // resource they acquired (Expression_Dig 0x00EEA9D0: ClearAllActionsIncludingLoopingAnimations, then
+    // PlayLoopingAnimation on the hero's resource). Same contract as above: an empty resource is a no-op.
+    CScriptGameResourceObjectScriptedThingBaseVTable* ResourceTable(CScriptGameResourceObjectScriptedThingBase* expert,
+                                                                   const char* method) {
+        auto* table = reinterpret_cast<CScriptGameResourceObjectScriptedThingBaseVTable*>(expert->pVTable);
+        if (!table) throw std::runtime_error(std::string("Retail resource ") + method + " is unavailable");
+        return table;
+    }
+    void MoveToThing(unsigned id, sol::object thing, float radius, int moveType, bool b1, bool b2, bool b3, bool b4) {
+        auto* expert = Get(id, Kind::Resource).resource.pImp.Data;
+        if (!expert) return;
+        ResourceTable(expert, "MoveToThing")->MoveToThing(expert, ResolveThingArgument(thing), radius,
+                                                          static_cast<EScriptEntityMoveType>(moveType), b1, b2, b3, b4);
+    }
+    void StopFollowingThing(unsigned id, sol::object thing) {
