+
+// Gameflow OnPersist: `SavedScriptNames` / `SavedCardDefNames` are std::vector<CCharString> members transferred
+// through CPersistContext::Transfer<std::vector<CCharString>> (0x49B8D0). The Lua side passes a sequence of
+// strings; the loaded sequence comes back.
+sol::table LuaQuestState::PersistTransferStringList(void* pContext, const std::string& name, sol::table values, sol::this_state s) {
+    sol::state_view lua(s);
+    LogToFile("    [PERSIST] Transferring string list '" + name + "'...");
+    sol::table result = lua.create_table();
+    if (!CPersistContext_Transfer_stringvector_API || !StringVector_PushBack_API || !StringVector_Destroy_API ||
+        !CCharString_ToConstChar_API) {
+        LogToFile("!!! ERROR: PersistTransferStringList - API not available!");
+        return values;
+    }
+    RetailStringVector vec{nullptr, nullptr, nullptr};
+    for (std::size_t i = 1; ; ++i) {
+        sol::optional<std::string> item = values[i];
+        if (!item) break;
+        FableString fs(item->c_str());
+        StringVector_PushBack_API(&vec, fs.get());
+    }
+    CPersistContext_Transfer_stringvector_API(static_cast<CPersistContext*>(pContext), name.c_str(), &vec);
+    int n = 0;
+    for (CCharString* p = vec.first; p && vec.last && p < vec.last; ++p) {
+        const char* text = CCharString_ToConstChar_API(p);
+        result[++n] = std::string(text ? text : "");
+    }
+    StringVector_Destroy_API(&vec);
+    LogToFile("    [PERSIST] ...List now has " + std::to_string(n) + " entries.");
+    return result;
+}
