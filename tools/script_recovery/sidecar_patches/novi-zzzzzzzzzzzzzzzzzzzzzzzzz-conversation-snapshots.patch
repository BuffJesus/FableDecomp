new file mode 100644
index 0000000..b2327e2
--- /dev/null
+++ b/FableScriptExtender/NoviConversationSnapshot.h
@@ -0,0 +1,54 @@
+#pragma once
+#include "sol/sol.hpp"
+#include <array>
+#include <string>
+#include <utility>
+#include <vector>
+
+// Script-visible values of retail CConversation (stride 0x5C). Native Copy at
+// E54CA0/E54C50 copies Lines and all four CString vectors independently.
+// Definition-base pool/identity fields are not exposed by this value snapshot.
+struct NoviConversationValue {
+    int lines = 0;
+    std::array<std::vector<std::string>, 4> strings;
+};
+
+template<class ReadString>
+inline std::vector<NoviConversationValue> NoviReadConversationValues(
+    const unsigned char* definitions, int offset, ReadString readString) {
+    std::vector<NoviConversationValue> out;
+    if (!definitions || offset < 0) return out;
+    struct Vec { const unsigned char* first; const unsigned char* last; const unsigned char* end; };
+    const auto* conversations = reinterpret_cast<const Vec*>(definitions + offset);
+    for (const unsigned char* record = conversations->first;
+         record && record + 0x5C <= conversations->last; record += 0x5C) {
+        NoviConversationValue value;
+        value.lines = *reinterpret_cast<const int*>(record + 0x28);
+        for (int field = 0; field < 4; ++field) {
+            const auto* strings = reinterpret_cast<const Vec*>(record + 0x2C + field * 12);
+            for (const unsigned char* p = strings->first; p && p < strings->last; p += 4)
+                value.strings[field].push_back(readString(p));
+        }
+        out.push_back(std::move(value));
+    }
+    return out;
+}
+
+inline sol::table NoviConversationValuesToLua(sol::state_view lua,
+    const std::vector<NoviConversationValue>& values) {
+    const char* fields[] = {"Speaker", "Dialogue", "Animation", "AnimLoop"};
+    sol::table out = lua.create_table();
+    int index = 0;
+    for (const auto& value : values) {
+        sol::table record = lua.create_table();
+        record["Lines"] = value.lines;
+        for (int field = 0; field < 4; ++field) {
+            sol::table strings = lua.create_table();
+            int line = 0;
+            for (const auto& text : value.strings[field]) strings[++line] = text;
+            record[fields[field]] = strings;
+        }
+        out[++index] = record;
+    }
+    return out;
+}
