+unsigned int LuaQuestState::GetContainerItemDefCount(CScriptThing* pContainer) {
+    if (!m_pGameInterface || !GetItemDefNamesFromContainer_API || !CCharString_Destroy) {
+        Log("!!! ERROR: GetContainerItemDefCount - API or string destructor not available!");
+        return 0;
+    }
+    if (!pContainer) {
+        Log("!!! ERROR: GetContainerItemDefCount - pContainer is null!");
+        return 0;
+    }
+    std::vector<CCharString> outNames;
+    GetItemDefNamesFromContainer_API(m_pGameInterface, pContainer, &outNames);
+    // Count native vector elements, including entries with no text. The public
+    // string-list conversion omits such entries and cannot establish emptiness.
+    const unsigned int count = static_cast<unsigned int>(outNames.size());
+    for (auto& name : outNames) {
+        CCharString_Destroy(&name);
+    }
+    return count;
+}
