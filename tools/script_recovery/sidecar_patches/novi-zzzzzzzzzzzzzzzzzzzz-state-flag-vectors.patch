diff --git a/FableScriptExtender/NoviNativeFlagVector.h b/FableScriptExtender/NoviNativeFlagVector.h
new file mode 100644
index 0000000..4e725a0
--- /dev/null
+++ b/FableScriptExtender/NoviNativeFlagVector.h
@@ -0,0 +1,41 @@
+#pragma once
+#include <cstring>
+#include <new>
+#include <vector>
+
+// Retail STLport vector<bool> uses one byte per element, not packed bits.
+// Transfer 0xCDCF80 may resize/reallocate with MSVCR71 malloc/free. Never
+// pass a modern std::vector's storage to that routine.
+class NoviNativeFlagVector {
+public:
+    struct Storage {
+        unsigned char* first = nullptr;
+        unsigned char* last = nullptr;
+        unsigned char* limit = nullptr;
+    } storage;
+    using Allocate = void* (*)(std::size_t);
+    using Release = void (*)(void*);
+
+    NoviNativeFlagVector(const std::vector<unsigned char>& values, Allocate allocate, Release release)
+        : release_(release) {
+        if (values.empty()) return;
+        storage.first = static_cast<unsigned char*>(allocate(values.size()));
+        if (!storage.first) throw std::bad_alloc();
+        storage.last = storage.limit = storage.first + values.size();
+        std::memcpy(storage.first, values.data(), values.size());
+    }
+    ~NoviNativeFlagVector() {
+        if (storage.first) release_(storage.first);
+    }
+    NoviNativeFlagVector(const NoviNativeFlagVector&) = delete;
+    NoviNativeFlagVector& operator=(const NoviNativeFlagVector&) = delete;
+
+    std::vector<unsigned char> CopyFlags() const {
+        if (!storage.first) return {};
+        std::vector<unsigned char> result(storage.first, storage.last);
+        for (auto& value : result) value = value != 0;
+        return result;
+    }
+private:
+    Release release_;
+};
