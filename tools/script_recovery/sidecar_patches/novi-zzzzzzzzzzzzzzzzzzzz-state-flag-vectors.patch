+        if (!context || !Game_malloc || !Game_free)
+            throw std::runtime_error("flag vector persistence requires context and game allocator");
+        static_assert(sizeof(NoviNativeFlagVector::Storage) == 12, "retail vector ABI is x86");
+        auto& values = NoviUnitData(self).flagVectors[name];
+        NoviNativeFlagVector native(values, Game_malloc, Game_free);
+        using Transfer = void(__thiscall*)(void*, const char*, NoviNativeFlagVector::Storage*);
+        ASLR<Transfer>(0x00CDCF80)(context, name.c_str(), &native.storage);
+        values = native.CopyFlags();
+    };
     quest["StateListClear"] = [](LuaQuestState& self, const std::string& name) { NoviUnitData(self).lists[name].clear(); };
