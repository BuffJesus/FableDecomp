     };
+    // Byte-per-flag vectors: 0x467686 resize, byte reads/stores, and
+    // CPersistContext::TransferVector 0xCDCF80 (BookDonated/BookOwned).
+    quest["StateFlagVectorResize"] = [](LuaQuestState& self, const std::string& name, int count) {
+        if (count < 0) throw std::out_of_range("negative flag vector size");
+        NoviUnitData(self).flagVectors[name].resize(static_cast<std::size_t>(count), 0);
+    };
+    quest["GetStateFlagVectorCount"] = [](LuaQuestState& self, const std::string& name) -> int {
