diff --git a/tests/native_flag_vector.cpp b/tests/native_flag_vector.cpp
new file mode 100644
index 0000000..db2d456
--- /dev/null
+++ b/tests/native_flag_vector.cpp
@@ -0,0 +1,69 @@
+#include "../FableScriptExtender/NoviNativeFlagVector.h"
+#include <cassert>
+#include <cstdlib>
+#include <map>
+#include <stdexcept>
+#include <type_traits>
+
+static std::map<void*, std::size_t> live;
+static bool fail = false;
+static int allocations = 0, releases = 0;
+static void* allocate(std::size_t size) {
+    ++allocations;
+    if (fail) return nullptr;
+    void* p = std::malloc(size);
+    assert(p && live.emplace(p, size).second);
+    return p;
+}
+static void release(void* p) {
+    assert(live.erase(p) == 1);
+    ++releases;
+    std::free(p);
+}
+int main() {
+    static_assert(!std::is_copy_constructible<NoviNativeFlagVector>::value, "no shared ownership");
+    static_assert(sizeof(NoviNativeFlagVector::Storage) == 3 * sizeof(void*), "three pointers");
+    {
+        NoviNativeFlagVector empty({}, allocate, release);
+        assert(!empty.storage.first && !empty.storage.last && !empty.storage.limit);
+        assert(empty.CopyFlags().empty() && allocations == 0);
+    }
+    const std::vector<unsigned char> original{0, 1, 2, 255};
+    {
+        NoviNativeFlagVector value(original, allocate, release);
+        assert(value.storage.first != original.data());
+        assert(value.storage.last - value.storage.first == 4);
+        assert(value.storage.limit == value.storage.last);
+        assert(value.CopyFlags() == (std::vector<unsigned char>{0, 1, 1, 1}));
+        value.storage.first[0] = 1;
+        assert(original[0] == 0);
+        // Retail defaults clears length while retaining the allocation.
+        value.storage.last = value.storage.first;
+        assert(value.CopyFlags().empty() && live.size() == 1);
+    }
+    assert(live.empty() && allocations == releases);
+    {
+        NoviNativeFlagVector value(original, allocate, release);
+        // Model the allocation replacement verified by the retail execution
+        // harness: the caller must free the new pointer, never the old one twice.
+        auto* replacement = static_cast<unsigned char*>(allocate(8));
+        replacement[0] = 0; replacement[1] = 7;
+        release(value.storage.first);
+        value.storage.first = replacement;
+        value.storage.last = replacement + 2;
+        value.storage.limit = replacement + 8;
+        assert(value.CopyFlags() == (std::vector<unsigned char>{0, 1}));
+    }
+    assert(live.empty() && allocations == releases);
+    try {
+        NoviNativeFlagVector value(original, allocate, release);
+        throw std::runtime_error("transfer interrupted");
+    } catch (const std::runtime_error&) {}
+    assert(live.empty() && allocations == releases);
+    fail = true;
+    try {
+        NoviNativeFlagVector value(original, allocate, release);
+        assert(false);
+    } catch (const std::bad_alloc&) {}
+    assert(live.empty() && allocations == releases + 1);
+}
