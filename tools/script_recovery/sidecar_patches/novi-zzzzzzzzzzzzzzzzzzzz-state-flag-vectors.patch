+    };
+    quest["GetStateFlagVectorAt"] = [](LuaQuestState& self, const std::string& name, int index) -> bool {
+        return NoviUnitData(self).flagVectors[name].at(static_cast<std::size_t>(index)) != 0;
+    };
+    quest["SetStateFlagVectorAt"] = [](LuaQuestState& self, const std::string& name, int index, bool value) {
+        NoviUnitData(self).flagVectors[name].at(static_cast<std::size_t>(index)) = value ? 1 : 0;
+    };
