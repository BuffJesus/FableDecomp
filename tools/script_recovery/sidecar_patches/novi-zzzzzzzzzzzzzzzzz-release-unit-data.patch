diff --git a/FableScriptExtender/NoviUnitBindings.h b/FableScriptExtender/NoviUnitBindings.h
index e41d905..e9f91da 100644
--- a/FableScriptExtender/NoviUnitBindings.h
+++ b/FableScriptExtender/NoviUnitBindings.h
@@ -37,10 +37,27 @@ struct NoviUnitQuestData {
     std::shared_ptr<LuaRetailResources> resources;
 };
 
-inline NoviUnitQuestData& NoviUnitData(LuaQuestState& self) {
+inline std::map<LuaQuestState*, NoviUnitQuestData>& NoviUnitTable() {
     // Quest states live for the quest instance; a side table keeps this header self-contained.
     static std::map<LuaQuestState*, NoviUnitQuestData> table;
-    return table[&self];
+    return table;
+}
+
+inline NoviUnitQuestData& NoviUnitData(LuaQuestState& self) {
+    return NoviUnitTable()[&self];
+}
+
+// The quest ends (~LuaQuestHost, after its threads and entity scripts are gone): release what its script object
+// owned -- retail destroys the seh_* member resources, csargs and member vectors in the script's destructor
+// (CV_BordelloScript 0x00E46A50), which also releases the control those resources held.
+inline void NoviReleaseUnitData(LuaQuestState* state) {
+    auto& table = NoviUnitTable();
+    auto found = table.find(state);
+    if (found == table.end()) return;
+    if (found->second.resources) {
+        try { found->second.resources->Close(); } catch (...) {}
+    }
+    table.erase(found);
 }
 
 // A copy of a thing handle owned by Lua/state storage (retail CScriptThing copy constructor + destructor).
