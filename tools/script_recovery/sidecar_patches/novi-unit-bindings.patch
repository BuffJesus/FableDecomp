diff --git a/FableScriptExtender/NoviUnitBindings.h b/FableScriptExtender/NoviUnitBindings.h
new file mode 100644
index 0000000..6625887
--- /dev/null
+++ b/FableScriptExtender/NoviUnitBindings.h
@@ -0,0 +1,420 @@
+#pragma once
+// Bindings the converter-generated quest units (Orchard Farm, ...) need beyond the New Oakvale set.
+// Evidence: docs/scripts/FSE_UPSTREAM_REQUIREMENTS.md and refs/script_recovery/orchard_farm/RUNTIME_API_GAPS.md
+// in the FableTLC tree. Every binding mirrors one native idiom the lowering pass recognises:
+//
+//   quest:GetStateThing / SetStateThing        CScriptThing quest members (Teams[i].TeamCrateCarrier, ...)
+//   quest:GetStateListCount / GetStateListAt   std::vector<CScriptThing> members (CrateList), stride-12 iteration
+//   quest:StateListPush / StateListErase       Vector_PushBack_ScriptThing 0x8ADF90 / vector::erase 0xCD3152
+//   quest:RetailResources()                    one long-lived LuaRetailResources per quest state
+//   quest:ReadGlobalGameData(offset)           *(int *)(*(DAT_0143e90c) + offset)
+//   thing:GetName / SetDataString / IsBeingCarriedBy / GetCurrentStateGroupType / IsEqualTo
+//                                              CScriptThing vtable slots 0x04 / 0x10 / 0xFC / 0x34 / 0x138
+//   quest:StateListClear / StateListSet        erase(begin,end) / a GSI out-argument fill; GetStateListCopy = the copy ctor
+//   quest:IsPlayerHoldingLockTargetButton / IsPlayerHoldingFireRangedWeaponButton / IsHeroInProjectileWeaponMode
+//                                              GSI slots 0x108 / 0x10C / 0x114 (GuildTraining skill tutorial, TraderConflict intro)
+//   quest:TextEntryExists(key)                 GSI slot 0x598 (TraderToRescue probes TEXT_QST_B11_<name>_ONTALK_<n>)
+//   quest:AddLogbookTutorialEntryPC(key)       retail 0x00CBEA81 (<key>_TITLE / <key>_PC, category 2): the !IsXbox sibling of 0x00CBE9EE
+//   quest:EntitySetAsOpinionSource(thing, x)   GSI slot 0x9B8 (CCharString) / 0x9B4 (long): the native overload pair
+//   quest:CreateEffect(result, name, ...)      GSI slot 0x190 (at position) / 0x194 (on thing): the native overload pair,
+//                                              hidden-result first, as the units call it
+//   thing:MsgIsHitBy(name) / MsgIsHitByAnySpecialAbilityFrom(name)
+//                                              CScriptThing vtable slots 0x54 / 0xA8 (the ...Hero forms bind "SCRIPT_NAME_HERO")
+//   thing:MsgHitFriendWithMeleeWeapon / MsgHitFriendWithRangedWeapon / MsgHitFriendWithBareHands
+//                                              CScriptThing vtable slots 0xBC / 0xC4 / 0xCC
+#include "sol/sol.hpp"
+#include "FableAPI.h"
+#include "EntityScriptingAPI.h"
+#include "LuaQuestState.h"
+#include "LuaRetailResources.h"
+#include <map>
+#include <memory>
+#include <string>
+#include <vector>
+
+struct NoviUnitQuestData {
+    std::map<std::string, std::vector<std::shared_ptr<CScriptThing>>> lists;
+    std::shared_ptr<LuaRetailResources> resources;
+};
+
+inline NoviUnitQuestData& NoviUnitData(LuaQuestState& self) {
+    // Quest states live for the quest instance; a side table keeps this header self-contained.
+    static std::map<LuaQuestState*, NoviUnitQuestData> table;
+    return table[&self];
+}
+
+// A copy of a thing handle owned by Lua/state storage (retail CScriptThing copy constructor + destructor).
+inline std::shared_ptr<CScriptThing> NoviCopyThing(const CScriptThing* source) {
+    if (!source || !Game_malloc || !RetailThing_Copy_API || !RetailThing_Destroy_API) return nullptr;
+    auto* buffer = static_cast<CScriptThing*>(Game_malloc(sizeof(CScriptThing)));
+    if (!buffer) return nullptr;
+    memset(buffer, 0, sizeof(CScriptThing));
+    RetailThing_Copy_API(buffer, source);
+    return std::shared_ptr<CScriptThing>(buffer, [](CScriptThing* p) {
+        if (!p) return;
+        RetailThing_Destroy_API(p);
+        Game_free(p);
+    });
+}
+
+inline std::string NoviCCharStringToStd(const CCharString* text) {
+    if (!text || !text->pStringData || !CCharString_ToConstChar_API) return "";
+    const char* raw = CCharString_ToConstChar_API(const_cast<CCharString*>(text));
+    return raw ? std::string(raw) : "";
+}
+
+// An unset CScriptThing member is an empty handle in retail (IsAlive false, IsDead true, IsEqualTo false),
+// never a null pointer: scripts call methods on it without checking.
+inline std::shared_ptr<CScriptThing> NoviEmptyThing() {
+    if (!Game_malloc) return nullptr;
+    auto* buffer = static_cast<CScriptThing*>(Game_malloc(sizeof(CScriptThing)));
+    if (!buffer) return nullptr;
+    memset(buffer, 0, sizeof(CScriptThing));
+    buffer->pVTable = g_pCScriptThingVTable;
+    return std::shared_ptr<CScriptThing>(buffer, [](CScriptThing* p) { if (p) Game_free(p); });
+}
+
+// VC7.1 std::vector<CScriptThing>: {_Myfirst, _Mylast, _Myend}, 12-byte elements (the retail script code reads
+// the count as (last - first) / 0xc). Null-initialised, the engine allocates it; we never touch its capacity.
+struct NoviRetailThingVector { CScriptThing* first; CScriptThing* last; CScriptThing* end; };
+static_assert(sizeof(CScriptThing) == 12, "CScriptThing must be the retail 12-byte layout");
+
+template <typename Fill>
+inline sol::table NoviFillThingVector(LuaQuestState& self, sol::this_state ts, Fill fill) {
+    sol::state_view lua(ts);
+    sol::table out = lua.create_table();
+    if (!Game_free || !RetailThing_Destroy_API) return out;
+    NoviRetailThingVector vec = { nullptr, nullptr, nullptr };
+    fill(&vec);
+    int index = 1;
+    for (CScriptThing* p = vec.first; p && p != vec.last; ++p) {
+        auto copy = NoviCopyThing(p);
+        if (copy) out[index++] = copy;
+    }
+    for (CScriptThing* p = vec.first; p && p != vec.last; ++p) RetailThing_Destroy_API(p);
+    if (vec.first) Game_free(vec.first);
+    return out;
+}
+
+inline void RegisterNoviUnitBindings(sol::usertype<LuaQuestState>& quest, sol::usertype<CScriptThing>& thing) {
+    // ---- thing-valued quest state ---------------------------------------------------------------
+    quest["GetStateThing"] = [](LuaQuestState& self, const std::string& name) {
+        auto thing = self.GetRetainedRetailThing(name);
+        return thing ? thing : NoviEmptyThing();
+    };
+    quest["SetStateThing"] = [](LuaQuestState& self, const std::string& name, sol::object value) {
+        if (value.is<std::shared_ptr<CScriptThing>>()) {
+            auto sp = value.as<std::shared_ptr<CScriptThing>>();
+            self.RetainRetailThing(name, sp ? NoviCopyThing(sp.get()) : nullptr);
+        } else if (value.is<CScriptThing*>()) {
+            self.RetainRetailThing(name, NoviCopyThing(value.as<CScriptThing*>()));
+        } else {
+            self.RetainRetailThing(name, nullptr);
+        }
+    };
+    // ---- std::vector<CScriptThing> quest state --------------------------------------------------
+    quest["GetStateListCount"] = [](LuaQuestState& self, const std::string& name) {
+        auto& lists = NoviUnitData(self).lists;
+        auto it = lists.find(name);
+        return it == lists.end() ? 0 : static_cast<int>(it->second.size());
+    };
+    quest["GetStateListAt"] = [](LuaQuestState& self, const std::string& name, int index) -> std::shared_ptr<CScriptThing> {
+        auto& lists = NoviUnitData(self).lists;
+        auto it = lists.find(name);
+        if (it == lists.end() || index < 0 || index >= static_cast<int>(it->second.size())) return nullptr;
+        return it->second[static_cast<size_t>(index)];
+    };
+    quest["StateListPush"] = [](LuaQuestState& self, const std::string& name, sol::object value) {
+        std::shared_ptr<CScriptThing> copy;
+        if (value.is<std::shared_ptr<CScriptThing>>()) {
+            auto sp = value.as<std::shared_ptr<CScriptThing>>();
+            copy = sp ? NoviCopyThing(sp.get()) : nullptr;
+        } else if (value.is<CScriptThing*>()) {
+            copy = NoviCopyThing(value.as<CScriptThing*>());
+        }
+        NoviUnitData(self).lists[name].push_back(copy);
+    };
+    quest["StateListErase"] = [](LuaQuestState& self, const std::string& name, int index) {
+        auto& lists = NoviUnitData(self).lists;
+        auto it = lists.find(name);
+        if (it == lists.end() || index < 0 || index >= static_cast<int>(it->second.size())) return;
+        it->second.erase(it->second.begin() + index);
+    };
+    quest["StateListClear"] = [](LuaQuestState& self, const std::string& name) { NoviUnitData(self).lists[name].clear(); };
+    // a member vector filled through an interface out-argument (`GSI->GetAllCreaturesExcludingHero(&m_AllCreatures)`)
+    // takes the table the binding returned; a by-value copy (`std::vector<CScriptThing> local(m_AllCreatures)`) is a table copy
+    quest["StateListSet"] = [](LuaQuestState& self, const std::string& name, sol::table values) {
+        auto& list = NoviUnitData(self).lists[name];
+        list.clear();
+        for (std::size_t i = 1; i <= values.size(); ++i) {
+            sol::object value = values[i];
+            if (value.is<std::shared_ptr<CScriptThing>>()) {
+                auto sp = value.as<std::shared_ptr<CScriptThing>>();
+                list.push_back(sp ? NoviCopyThing(sp.get()) : nullptr);
+            } else if (value.is<CScriptThing*>()) {
+                list.push_back(NoviCopyThing(value.as<CScriptThing*>()));
+            }
+        }
+    };
+    quest["GetStateListCopy"] = [](LuaQuestState& self, const std::string& name, sol::this_state ts) -> sol::table {
+        sol::state_view lua(ts);
+        sol::table out = lua.create_table();
+        auto& lists = NoviUnitData(self).lists;
+        auto it = lists.find(name);
+        if (it != lists.end()) {
+            int n = 0;
+            for (auto& sp : it->second) out[++n] = sp ? NoviCopyThing(sp.get()) : nullptr;
+        }
+        return out;
+    };
+    // ---- player input predicates (GSI slots 0x108 / 0x10C / 0x114; FableString-free bool() const) ---
+    quest["IsPlayerHoldingLockTargetButton"] = [](LuaQuestState& self) -> bool {
+        auto* gsi = self.GetGameInterface();
+        return (gsi && IsPlayerHoldingLockTargetButton_API) ? IsPlayerHoldingLockTargetButton_API(gsi) : false;
+    };
+    quest["IsPlayerHoldingFireRangedWeaponButton"] = [](LuaQuestState& self) -> bool {
+        auto* gsi = self.GetGameInterface();
+        return (gsi && IsPlayerHoldingFireRangedWeaponButton_API) ? IsPlayerHoldingFireRangedWeaponButton_API(gsi) : false;
+    };
+    quest["IsHeroInProjectileWeaponMode"] = [](LuaQuestState& self) -> bool {
+        auto* gsi = self.GetGameInterface();
+        return (gsi && IsHeroInProjectileWeaponMode_API) ? IsHeroInProjectileWeaponMode_API(gsi) : false;
+    };
+    // ---- text table probe (GSI slot 0x598, bool(const CCharString&) const) ----------------------
+    // The key is required natively; a call without one is a converter gap (the operand was dropped), logged and false.
+    quest["TextEntryExists"] = [](LuaQuestState& self, sol::optional<std::string> key) -> bool {
+        auto* gsi = self.GetGameInterface();
+        if (!gsi || !TextEntryExists_API) return false;
+        if (!key) { LogToFile("!!! WARNING: TextEntryExists called without a key (converter gap); returning false."); return false; }
+        FableString text(key->c_str());
+        return TextEntryExists_API(gsi, text.get());
+    };
+    // ---- PC tutorial logbook entry (retail 0x00CBEA81, the sibling of 0x00CBE9EE = AddLogbookTutorialEntry) ----
+    // `__thiscall(const CCharString* key)`: title <key>_TITLE, body <key>_PC (0x122e248), category 2 through GSI
+    // +0x4D0, then the helper's own one-frame yield (disassembly 2026-09-19). Retail scripts call it on the
+    // !IsXbox() path (PreMelee Guildmaster: TEXT_QST_LOG_COMBAT_LOCKINGON / _PUNCHING after the PC instructions).
+    quest["AddLogbookTutorialEntryPC"] = [](LuaQuestState& self, const std::string& key) {
+        (void)self;
+        auto fn = ASLR<tAddLogbookTutorialEntry>(0x00CBEA81);
+        if (!fn) { LogToFile("!!! ERROR: AddLogbookTutorialEntryPC - API not available!"); return; }
+        FableString text(key.c_str());
+        fn(text.get());
+    };
+    // ---- opinion source (the native overload pair: 0x9B8 CCharString / 0x9B4 long) --------------
+    quest["EntitySetAsOpinionSource"] = [](LuaQuestState& self, sol::object thing, sol::object source) {
+        auto* gsi = self.GetGameInterface();
+        if (!gsi) return;
+        CScriptThing* target = nullptr;
+        if (thing.is<std::shared_ptr<CScriptThing>>()) target = thing.as<std::shared_ptr<CScriptThing>>().get();
+        else if (thing.is<CScriptThing*>()) target = thing.as<CScriptThing*>();
+        if (!target) { LogToFile("!!! ERROR: EntitySetAsOpinionSource - thing is null!"); return; }
+        if (source.is<std::string>()) {
+            if (!EntitySetAsOpinionSourceByString_API) return;
+            FableString name(source.as<std::string>().c_str());
+            EntitySetAsOpinionSourceByString_API(gsi, target, name.get());
+        } else if (source.is<int>()) {
+            if (!EntitySetAsOpinionSourceByInt_API) return;
+            EntitySetAsOpinionSourceByInt_API(gsi, target, source.as<int>());
+        } else {
+            LogToFile("!!! ERROR: EntitySetAsOpinionSource - source must be a string (0x9B8) or an integer (0x9B4).");
+        }
+    };
+    // ---- CreateEffect, native overload pair with the hidden result first -----------------------
+    //   CreateEffect(result, effectName, {x,y,z}, scriptName, angle, independent, alwaysUpdate)   slot 0x190
+    //   CreateEffect(result, effectName, onThing, boneName, scriptName, independent, alwaysUpdate) slot 0x194
+    // `result` is the CScriptThing the native constructs into: when the unit passes a thing handle it is assigned
+    // (destroy + copy-construct, the retail hidden-return idiom); the handle is also returned.
+    quest["CreateEffect"] = [](LuaQuestState& self, sol::object result, const std::string& effectName, sol::object where,
+                               sol::object arg4, sol::object arg5, sol::optional<bool> independent, sol::optional<bool> alwaysUpdate)
+        -> std::shared_ptr<CScriptThing> {
+        auto* gsi = self.GetGameInterface();
+        if (!gsi || !Game_malloc) return nullptr;
+        auto* buffer = static_cast<CScriptThing*>(Game_malloc(sizeof(CScriptThing)));
+        if (!buffer) return nullptr;
+        memset(buffer, 0, sizeof(CScriptThing));
+        FableString fsEffect(effectName.c_str());
+        const bool finalIndependent = independent.value_or(false);
+        const bool finalAlwaysUpdate = alwaysUpdate.value_or(false);
+        bool called = false;
+        CScriptThing* onThing = nullptr;
+        if (where.is<std::shared_ptr<CScriptThing>>()) onThing = where.as<std::shared_ptr<CScriptThing>>().get();
+        else if (where.is<CScriptThing*>()) onThing = where.as<CScriptThing*>();
+        if (onThing && arg5.is<std::string>()) {
+            // on-thing overload: (result, effect, thing, bone, scriptName, bool, bool)
+            if (CreateEffect_OnThing_API) {
+                FableString fsBone(arg4.is<std::string>() ? arg4.as<std::string>().c_str() : "");
+                FableString fsScript(arg5.as<std::string>().c_str());
+                CreateEffect_OnThing_API(gsi, buffer, fsEffect, onThing, fsBone, fsScript, finalIndependent, finalAlwaysUpdate);
+                called = true;
+            }
+        } else if (where.is<sol::table>()) {
+            // at-position overload: (result, effect, {x,y,z}, scriptName, angle, bool, bool)
+            if (CreateEffect_AtPosition_API) {
+                sol::table position = where.as<sol::table>();
+                const C3DVector pos = { position["x"].get_or(0.0f), position["y"].get_or(0.0f), position["z"].get_or(0.0f) };
+                FableString fsScript(arg4.is<std::string>() ? arg4.as<std::string>().c_str() : "");
+                const float angle = arg5.is<float>() ? arg5.as<float>() : 0.0f;
+                CreateEffect_AtPosition_API(gsi, buffer, fsEffect, &pos, fsScript, angle, finalIndependent, finalAlwaysUpdate);
+                called = true;
+            }
+        } else {
+            LogToFile("!!! ERROR: CreateEffect(" + effectName + ") - third operand is neither a position table nor a thing (converter gap); no effect created.");
+        }
+        if (!called) { Game_free(buffer); return nullptr; }
+        auto handle = WrapScriptThingOutput(buffer);
+        CScriptThing* out = nullptr;
+        if (result.is<std::shared_ptr<CScriptThing>>()) out = result.as<std::shared_ptr<CScriptThing>>().get();
+        else if (result.is<CScriptThing*>()) out = result.as<CScriptThing*>();
+        if (out && handle && out != handle.get() && RetailThing_Copy_API && RetailThing_Destroy_API) {
+            RetailThing_Destroy_API(out);
+            memset(out, 0, sizeof(CScriptThing));
+            RetailThing_Copy_API(out, handle.get());
+        }
+        return handle;
+    };
+    // ---- long-lived retail resources ------------------------------------------------------------
+    quest["RetailResources"] = [](LuaQuestState& self) {
+        auto& data = NoviUnitData(self);
+        if (!data.resources) data.resources = std::make_shared<LuaRetailResources>(self.GetGameInterface());
+        return data.resources;
+    };
+    quest["CloseRetailResources"] = [](LuaQuestState& self) {
+        auto& data = NoviUnitData(self);
+        if (data.resources) { data.resources->Close(); data.resources.reset(); }
+    };
+    // ---- global game data table -----------------------------------------------------------------
+    quest["ReadGlobalGameData"] = [](LuaQuestState&, int offset) -> int {
+        auto* definitions = *ASLR<const unsigned char**>(0x0143E90C);
+        if (!definitions || offset < 0) return 0;
+        return *reinterpret_cast<const volatile int*>(definitions + offset);
+    };
+    quest["ReadGlobalGameDataFloat"] = [](LuaQuestState&, int offset) -> float {
+        auto* definitions = *ASLR<const unsigned char**>(0x0143E90C);
+        if (!definitions || offset < 0) return 0.0f;
+        return *reinterpret_cast<const volatile float*>(definitions + offset);
+    };
+    // a float array the table points at (`*(float **)(table + offset)`, e.g. the guild grade thresholds
+    // at +0xeb4): element `index` of it
+    quest["ReadGlobalGameDataFloatAt"] = [](LuaQuestState&, int offset, int index) -> float {
+        auto* definitions = *ASLR<const unsigned char**>(0x0143E90C);
+        if (!definitions || offset < 0 || index < 0) return 0.0f;
+        auto* array = *reinterpret_cast<const float* const volatile*>(definitions + offset);
+        return array ? array[index] : 0.0f;
+    };
+    // ---- CScriptThing methods -------------------------------------------------------------------
+    thing["GetName"] = [](CScriptThing* me) -> std::string {
+        if (!me || !me->pVTable) return "";
+        auto* vt = reinterpret_cast<CScriptThingVTable*>(me->pVTable);
+        return vt->GetName ? NoviCCharStringToStd(vt->GetName(me)) : "";
+    };
+    thing["SetDataString"] = [](CScriptThing* me, const std::string& value) {
+        if (!me || !me->pVTable || !CCharString_Construct_Literal || !CCharString_Destroy) return;
+        auto* vt = reinterpret_cast<CScriptThingVTable*>(me->pVTable);
+        if (!vt->SetDataString) return;
+        CCharString text{};
+        CCharString_Construct_Literal(&text, value.c_str(), -1);
+        vt->SetDataString(me, &text);
+        CCharString_Destroy(&text);
+    };
+    thing["IsBeingCarriedBy"] = [](CScriptThing* me, const std::string& carrierName) -> bool {
+        if (!me || !me->pVTable || !CCharString_Construct_Literal || !CCharString_Destroy) return false;
+        auto* vt = reinterpret_cast<CScriptThingVTable*>(me->pVTable);
+        if (!vt->IsBeingCarriedBy) return false;
+        CCharString text{};
+        CCharString_Construct_Literal(&text, carrierName.c_str(), -1);
+        const bool carried = vt->IsBeingCarriedBy(me, &text);
+        CCharString_Destroy(&text);
+        return carried;
+    };
+    thing["GetCurrentStateGroupType"] = [](CScriptThing* me) -> int {
+        if (!me || !me->pVTable) return 0;
+        auto* vt = reinterpret_cast<CScriptThingVTable*>(me->pVTable);
+        return vt->GetCurrentStateGroupType ? static_cast<int>(vt->GetCurrentStateGroupType(me)) : 0;
+    };
+    // ---- hit-event queries by attacker script name (CScriptThing slots 0x54 / 0xA8) --------------
+    // Same bodies as LuaEntityAPI::MsgIsHitByHero / MsgIsHitByAnySpecialAbilityFromHero, which pass "SCRIPT_NAME_HERO";
+    // retail CGameScriptThing::MsgIsHitBy (0x8D0FB0) treats an empty name as "hit by anything this frame"
+    // (the CIsHitEventHitByThingWithScriptName filter is only added for a non-empty name).
+    thing["MsgIsHitBy"] = [](CScriptThing* me, const std::string& hitterName) -> bool {
+        if (!me || !me->pVTable) return false;
+        auto* vt = reinterpret_cast<CScriptThingVTable*>(me->pVTable);
+        if (!vt->MsgIsHitBy) return false;
+        FableString name(hitterName.c_str());
+        const bool hit = vt->MsgIsHitBy(me, name.get());
+        if (hit) LogToFile("    [HitEvidence] MsgIsHitBy(" + hitterName + ") returned true.");
+        return hit;
+    };
+    thing["MsgIsHitByAnySpecialAbilityFrom"] = [](CScriptThing* me, const std::string& sourceName) -> bool {
+        if (!me || !me->pVTable) return false;
+        auto* vt = reinterpret_cast<CScriptThingVTable*>(me->pVTable);
+        if (!vt->MsgIsHitByAnySpecialAbilityFrom) return false;
+        FableString name(sourceName.c_str());
+        const bool hit = vt->MsgIsHitByAnySpecialAbilityFrom(me, name.get());
+        if (hit) LogToFile("    [HitEvidence] MsgIsHitByAnySpecialAbilityFrom(" + sourceName + ") returned true.");
+        return hit;
+    };
+    // ---- friendly-fire messages, no operand (CScriptThing slots 0xBC / 0xC4 / 0xCC) --------------
+    thing["MsgHitFriendWithMeleeWeapon"] = [](CScriptThing* me) -> bool {
+        if (!me || !me->pVTable) return false;
+        auto* vt = reinterpret_cast<CScriptThingVTable*>(me->pVTable);
+        return vt->MsgHitFriendWithMeleeWeapon ? vt->MsgHitFriendWithMeleeWeapon(me) : false;
+    };
+    thing["MsgHitFriendWithRangedWeapon"] = [](CScriptThing* me) -> bool {
+        if (!me || !me->pVTable) return false;
+        auto* vt = reinterpret_cast<CScriptThingVTable*>(me->pVTable);
+        return vt->MsgHitFriendWithRangedWeapon ? vt->MsgHitFriendWithRangedWeapon(me) : false;
+    };
+    thing["MsgHitFriendWithBareHands"] = [](CScriptThing* me) -> bool {
+        if (!me || !me->pVTable) return false;
+        auto* vt = reinterpret_cast<CScriptThingVTable*>(me->pVTable);
+        return vt->MsgHitFriendWithBareHands ? vt->MsgHitFriendWithBareHands(me) : false;
+    };
+    // CScriptThing::operator== goes through the implementation object's vtable (CGameScriptThing slot 0x138),
+    // exactly as the native scripts call it (`(**(**(int **)(thing + 4) + 0x138))(data, other.Data)`).
+    thing["IsEqualTo"] = [](CScriptThing* me, sol::object other) -> bool {
+        if (!me) return false;
+        const CScriptThing* rhs = nullptr;
+        if (other.is<std::shared_ptr<CScriptThing>>()) rhs = other.as<std::shared_ptr<CScriptThing>>().get();
+        else if (other.is<CScriptThing*>()) rhs = other.as<CScriptThing*>();
+        if (!rhs) return false;
+        auto* imp = reinterpret_cast<CGameScriptThing*>(me->pImp.Data);
+        if (!imp || !imp->pVTable) return me->pImp.Data == rhs->pImp.Data;
+        auto* vt = reinterpret_cast<CGameScriptThingVTable*>(imp->pVTable);
+        return vt->IsEqualTo ? vt->IsEqualTo(imp, rhs) : me->pImp.Data == rhs->pImp.Data;
+    };
+}
+
+// Registered AFTER the upstream bindings (LuaManager.cpp binds its own GetAll* later than
+// RegisterNoviUnitBindings, and the last registration of a name wins).
+inline void RegisterNoviUnitOverrides(sol::usertype<LuaQuestState>& quest) {
+    // ---- GetAll* fills: the engine must own the vector buffer ------------------------------------
+    // Upstream hands these GSI slots a DLL-side std::vector with reserve(10/20). Retail fills it with the
+    // VC7.1 CRT: once the count exceeds the reserve (the Guild complex has more than 20 creatures) its
+    // push_back reallocates and frees the DLL buffer with the retail allocator -- a cross-heap free, crash
+    // on entering the Guild (CheckFriendlyAttacks' GetAllCreaturesExcludingHero, 2026-09-19). A null
+    // retail-layout vector {first, last, end} lets retail allocate; the elements are copied out with the
+    // retail copy constructor, destroyed, and the buffer released with retail's free.
+    quest["GetAllCreaturesExcludingHero"] = [](LuaQuestState& self, sol::this_state ts) -> sol::table {
+        return NoviFillThingVector(self, ts, [&](NoviRetailThingVector* vec) {
+            auto* gsi = self.GetGameInterface();
+            if (gsi && GetAllCreaturesExcludingHero_API)
+                GetAllCreaturesExcludingHero_API(gsi, reinterpret_cast<std::vector<CScriptThing>*>(vec));
+        });
+    };
+    quest["GetAllThingsWithScriptName"] = [](LuaQuestState& self, const std::string& name, sol::this_state ts) -> sol::table {
+        return NoviFillThingVector(self, ts, [&](NoviRetailThingVector* vec) {
+            auto* gsi = self.GetGameInterface();
+            if (!gsi || !GetAllThingsWithScriptName_API) return;
+            FableString text(name.c_str());
+            GetAllThingsWithScriptName_API(gsi, text.get(), reinterpret_cast<std::vector<CScriptThing>*>(vec));
+        });
+    };
+    quest["GetAllThingsWithDefName"] = [](LuaQuestState& self, const std::string& name, sol::this_state ts) -> sol::table {
+        return NoviFillThingVector(self, ts, [&](NoviRetailThingVector* vec) {
+            auto* gsi = self.GetGameInterface();
+            if (!gsi || !GetAllThingsWithDefName_API) return;
+            FableString text(name.c_str());
+            GetAllThingsWithDefName_API(gsi, text.get(), reinterpret_cast<std::vector<CScriptThing>*>(vec));
+        });
+    };
+}
