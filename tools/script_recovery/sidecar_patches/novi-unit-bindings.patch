+void LuaManager::LogQuestThreadFlags(const char* context) {
+    static std::map<void*, int> last;
+    for (auto& kv : m_entityScriptDataMap) {
+        LuaEntityHost* host = kv.first;
+        if (!host || !host->m_pParentHost) continue;
+        void* base = &host->m_pParentHost->base;
+        void* thread = *reinterpret_cast<void**>(reinterpret_cast<char*>(base) + 0x2c);
+        int flag = thread ? *(reinterpret_cast<unsigned char*>(thread) + 5) : -1;
+        auto it = last.find(base);
+        if (it != last.end() && it->second == flag) continue;
+        last[base] = flag;
+        LogToFile(std::string("    [QuestThreadFlag] ") + host->m_pParentHost->GetScriptName() + " thread=" +
+                  std::to_string(reinterpret_cast<uintptr_t>(thread)) + " terminating=" + std::to_string(flag) +
+                  " at " + (context ? context : "?"));
+    }
+}
