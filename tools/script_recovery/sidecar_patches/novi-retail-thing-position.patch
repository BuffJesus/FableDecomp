+    sol::table GetThingPosition(sol::object value, sol::this_state state) {
+        CheckOpen();
+        CScriptThing* actor = nullptr;
+        if (value.valid() && value.get_type() != sol::type::nil) {
+            if (value.get_type() != sol::type::userdata || !value.is<CScriptThing*>())
+                throw std::runtime_error("Retail Thing position requires a Thing or nil");
+            actor = value.as<CScriptThing*>();
+        }
+        const volatile C3DVector* position = nullptr;
+        if (actor) {
+            auto* table = reinterpret_cast<CScriptThingVTable*>(actor->pVTable);
+            if (!table || !table->GetPos)
+                throw std::runtime_error("Retail Thing position getter unavailable");
+            position = table->GetPos(actor);
+        } else {
+            position = ASLR<const volatile C3DVector*>(0x0143E8E0);
+        }
+        if (!position) throw std::runtime_error("Retail Thing position returned a null vector");
+        // Snapshot before creating Lua tables, which can trigger collection.
+        const float x = position->x, y = position->y, z = position->z;
+        sol::state_view lua(state);
+        return lua.create_table_with("x", x, "y", y, "z", z);
+    }
