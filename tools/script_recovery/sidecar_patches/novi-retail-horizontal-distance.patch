+bool IsHorizontalDistanceBetweenThingsUnder(CScriptThing* first, CScriptThing* second, float range) {
+    CheckOpen();
+    using Distance = bool(__fastcall*)(CScriptThing*, CScriptThing*, float);
+    // Native 2D predicate owns alive checks, getter order, XY snapshots and
+    // strict x87 comparison. A Lua nil denotes an empty native Thing wrapper.
+    CScriptThing empty{};
+    empty.pVTable = g_pCScriptThingVTable;
+    if ((!first || !second) && !empty.pVTable)
+        throw std::runtime_error("Retail empty Thing vtable unavailable");
+    first = first ? first : &empty;
+    second = second ? second : &empty;
+    auto predicate = ASLR<Distance>(0x00CBE371);
+    if (!predicate) throw std::runtime_error("Retail horizontal distance predicate unavailable");
+    return predicate(first, second, range);
+}
 struct BullyNativeLiteral {
     CCharString value{};
     explicit BullyNativeLiteral(const char* text) { CCharString_Construct_Literal(&value, text, -1); }
