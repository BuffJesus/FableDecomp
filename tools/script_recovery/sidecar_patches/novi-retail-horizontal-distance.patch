     type["IsDistanceBetweenThingsUnder"] = &LuaRetailResources::IsDistanceBetweenThingsUnder;
+    type["IsHorizontalDistanceBetweenThingsUnder"] = [](LuaRetailResources& resources, sol::object first, sol::object second, sol::object range) {
+        auto thing = [](const sol::object& value) -> CScriptThing* {
+            if (!value.valid() || value.get_type() == sol::type::nil) return nullptr;
+            if (value.get_type() != sol::type::userdata || !value.is<CScriptThing*>())
+                throw std::runtime_error("Retail horizontal distance requires Things or nil");
+            return value.as<CScriptThing*>();
+        };
+        if (!range.valid() || range.get_type() != sol::type::number)
+            throw std::runtime_error("Retail horizontal distance range requires a number");
+        auto* firstThing = thing(first);
+        auto* secondThing = thing(second);
+        return resources.IsHorizontalDistanceBetweenThingsUnder(firstThing, secondThing, range.as<float>());
+    };
     type["IsDistanceOver"] = &LuaRetailResources::IsDistanceOver;
