+// Retail std::map<CCharString,CCharString>::clear 0x9AACE0 (disasm 2026-09-27: erase every node through
+// 0x9AA830, relink the head, size 0) -- the destructor 0x9AC310 is the same body plus freeing the head, so
+// destroy + construct in place leaves the same empty map.
+void ClearStringMap(unsigned id) {
+    auto& e = Get(id, Kind::StringMap);
+    StdMap_String_Destroy_API(e.map);
+    StdMap_String_Construct_API(e.map);
+}
+
+// Script-member resource objects (PDB `seh_*` CScriptGameResourceObjectScriptedThingBase members) and
+// member string maps (Bordello `csargs`): retail constructs them with the script object and destroys them in
+// its destructor (CV_BordelloScript 0x00E46A50), so they outlive every callback. This scope is the quest
+// state's long-lived one (quest:RetailResources()), which the quest and each of its entity VMs share, so an
+// entity's `parent->seh_Guard = res` (0x8ABD10) is what the quest's PlayCutscene 0x00E3E720 later reads.
+// An entity's own member is keyed by its owner thing as well (one slot per entity instance).
+unsigned MemberResource(const std::string& name, sol::object owner) {
+    const std::string key = MemberKey(name, owner);
+    auto found = m_members.find(key);
+    if (found != m_members.end()) return found->second;
+    const unsigned id = NewResource();
+    m_members.emplace(key, id);
+    return id;
+}
+unsigned MemberStringMap(const std::string& name, sol::object owner) {
+    const std::string key = "strings:" + MemberKey(name, owner);
+    auto found = m_members.find(key);
+    if (found != m_members.end()) return found->second;
+    const unsigned id = NewStringMap();
+    m_members.emplace(key, id);
+    return id;
+}
+// Retail CScriptGameResourceObjectScriptedThingBase::operator= 0x8ABD10: the destination takes a counted copy
+// of the source's handle. The copy holds the same control, so it takes over the registry entry that lets
+// cutscene assembly and `me:` commands find the controlling resource once the source local is released.
+void AssignResource(unsigned destination, unsigned source) {
+    auto& d = Get(destination, Kind::Resource);
+    auto& s = Get(source, Kind::Resource);
+    if (&d == &s) return;
+    Unregister(d);
+    CBaseObject_Assign_API(&d.resource, &s.resource);
+    d.prepared = s.prepared;
+    if (s.controlledData && d.resource.pImp.Data) {
+        d.controlledData = s.controlledData;
+        g_controlHandlesByEntityData[d.controlledData] = &d.resource;
+        g_retailResourceHandles.insert(&d.resource);
+    }
+}
