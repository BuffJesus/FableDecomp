+void LuaQuestState::KillSpawnedFunction(const std::string& functionName, int identifier) {
+    if (!m_pParentHost || m_pParentHost->IsClosing())
+        throw std::runtime_error("Quest host unavailable for spawned-function control");
+    if (!g_fableBase || !CCharString_Construct_Literal || !CCharString_Destroy)
+        throw std::runtime_error("Retail spawned-function APIs unavailable");
+    if (functionName.find('\0') != std::string::npos)
+        throw std::runtime_error("Spawned-function name contains an embedded NUL");
+    FableString name(functionName.c_str());
+    using Kill = void(__thiscall*)(CScriptBase_Retail*, const CCharString*, int);
+    ASLR<Kill>(0x00CB7AA0)(&m_pParentHost->base, name.get(), identifier);
+}
