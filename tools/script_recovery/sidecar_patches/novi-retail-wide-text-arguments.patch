 inline void RegisterRetailResources(sol::state& lua) {
+    auto wideText = lua.new_usertype<RetailWideTextArguments>("RetailWideTextArguments", sol::no_constructor);
+    wideText["AppendInteger"] = [](RetailWideTextArguments& args, sol::object value) {
+        auto* state = value.lua_state();
+        value.push();
+        const bool isInteger = lua_isinteger(state, -1) != 0;
+        const lua_Integer integer = isInteger ? lua_tointeger(state, -1) : 0;
+        lua_pop(state, 1);
+        if (!isInteger || integer < -2147483647LL - 1 || integer > 2147483647LL)
+            throw std::runtime_error("Retail integer text requires a signed32 Lua integer");
+        args.AppendInteger(static_cast<std::int32_t>(integer));
+    };
+    wideText["FormatGlobalText"] = [](RetailWideTextArguments& args, unsigned address, const std::string& key) {
+        args.FormatInto(ResolveRetailGlobalWideText(address), key);
+    };
+    wideText["ClearGlobalText"] = [](RetailWideTextArguments& args, unsigned address) {
+        args.ClearInto(ResolveRetailGlobalWideText(address));
+    };
+    wideText["Count"] = &RetailWideTextArguments::Count;
+    wideText["Close"] = &RetailWideTextArguments::Close;
