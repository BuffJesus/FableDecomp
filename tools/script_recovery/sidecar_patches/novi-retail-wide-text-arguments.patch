diff --git a/FableScriptExtender/retail_wide_text_arguments.h b/FableScriptExtender/retail_wide_text_arguments.h
new file mode 100644
index 0000000..1c72dc0
--- /dev/null
+++ b/FableScriptExtender/retail_wide_text_arguments.h
@@ -0,0 +1,123 @@
+#pragma once
+#include <cstdint>
+#include <stdexcept>
+#include <string>
+
+struct RetailWideTextValue { void* data = nullptr; };
+struct RetailNarrowTextKey { void* data = nullptr; };
+struct RetailWideTextVector {
+    RetailWideTextValue* begin = nullptr;
+    RetailWideTextValue* end = nullptr;
+    RetailWideTextValue* capacity = nullptr;
+};
+static_assert(sizeof(RetailWideTextValue) == 4, "Retail wide strings are one Win32 pointer");
+static_assert(sizeof(RetailNarrowTextKey) == 4, "Retail narrow strings are one Win32 pointer");
+static_assert(sizeof(RetailWideTextVector) == 12, "Retail vector layout is three Win32 pointers");
+static_assert(sizeof(wchar_t) == 2, "Retail wide text is UTF-16");
+
+struct RetailWideTextAPIs {
+    using Construct = RetailWideTextValue* (__thiscall*)(RetailWideTextValue*);
+    using FormatInteger = void (__cdecl*)(RetailWideTextValue*, const wchar_t*, ...);
+    using Copy = RetailWideTextValue* (__thiscall*)(RetailWideTextValue*, const RetailWideTextValue*);
+    using Destroy = void (__thiscall*)(RetailWideTextValue*);
+    using Append = void (__thiscall*)(RetailWideTextVector*, const RetailWideTextValue*);
+    using DestroyVector = void (__thiscall*)(RetailWideTextVector*);
+    using ConstructKey = RetailNarrowTextKey* (__thiscall*)(RetailNarrowTextKey*, const char*, int);
+    using DestroyKey = void (__thiscall*)(RetailNarrowTextKey*);
+    using FormatText = RetailWideTextValue* (__thiscall*)(void*, RetailWideTextValue*, const RetailNarrowTextKey*, const RetailWideTextVector*);
+    using AssignText = RetailWideTextValue* (__thiscall*)(RetailWideTextValue*, const wchar_t*);
+    Construct construct = nullptr;
+    FormatInteger formatInteger = nullptr;
+    Copy copy = nullptr;
+    Destroy destroy = nullptr;
+    Append append = nullptr;
+    DestroyVector destroyVector = nullptr;
+    ConstructKey constructKey = nullptr;
+    DestroyKey destroyKey = nullptr;
+    FormatText formatText = nullptr;
+    Copy assign = nullptr;
+    AssignText assignText = nullptr;
+};
+
+// Native vector storage owns its wide values until explicit Close. Formatting
+// into a global copies its value; closing this vector never clears that global.
+class RetailWideTextArguments {
+public:
+    RetailWideTextArguments(void* game, RetailWideTextAPIs api) : m_game(game), m_api(api) {
+        if (!game || !api.construct || !api.formatInteger || !api.copy || !api.destroy ||
+            !api.append || !api.destroyVector || !api.constructKey || !api.destroyKey ||
+            !api.formatText || !api.assign || !api.assignText)
+            throw std::runtime_error("Retail wide-text API is unavailable");
+    }
+    ~RetailWideTextArguments() { try { Close(); } catch (...) {} }
+    RetailWideTextArguments(const RetailWideTextArguments&) = delete;
+    RetailWideTextArguments& operator=(const RetailWideTextArguments&) = delete;
+
+    void AppendInteger(std::int32_t value) {
+        CheckOpen();
+        RetailWideTextValue formatted{}, copied{};
+        bool formattedLive = false, copiedLive = false;
+        try {
+            m_api.construct(&formatted); formattedLive = true;
+            m_api.formatInteger(&formatted, L"%d", value);
+            m_api.copy(&copied, &formatted); copiedLive = true;
+            formattedLive = false; m_api.destroy(&formatted);
+            m_api.append(&m_values, &copied);
+            copiedLive = false; m_api.destroy(&copied);
+        } catch (...) {
+            if (copiedLive) try { m_api.destroy(&copied); } catch (...) {}
+            if (formattedLive) try { m_api.destroy(&formatted); } catch (...) {}
+            throw;
+        }
+    }
+
+    void FormatInto(RetailWideTextValue* target, const std::string& key) {
+        CheckOpen();
+        if (!target) throw std::runtime_error("Retail global wide-text target is null");
+        if (key.find('\0') != std::string::npos)
+            throw std::runtime_error("Retail text key contains a null byte");
+        RetailNarrowTextKey nativeKey{};
+        RetailWideTextValue result{};
+        bool keyLive = false, resultLive = false;
+        try {
+            m_api.constructKey(&nativeKey, key.c_str(), -1); keyLive = true;
+            auto* returned = m_api.formatText(m_game, &result, &nativeKey, &m_values);
+            resultLive = true;
+            m_api.assign(target, returned);
+            resultLive = false; m_api.destroy(&result);
+            keyLive = false; m_api.destroyKey(&nativeKey);
+        } catch (...) {
+            if (resultLive) try { m_api.destroy(&result); } catch (...) {}
+            if (keyLive) try { m_api.destroyKey(&nativeKey); } catch (...) {}
+            throw;
+        }
+    }
+
+    void ClearInto(RetailWideTextValue* target) {
+        CheckOpen();
+        if (!target) throw std::runtime_error("Retail global wide-text target is null");
+        m_api.assignText(target, L"");
+    }
+
+    unsigned Count() const {
+        CheckOpen();
+        return static_cast<unsigned>((reinterpret_cast<std::uintptr_t>(m_values.end) -
+            reinterpret_cast<std::uintptr_t>(m_values.begin)) / sizeof(RetailWideTextValue));
+    }
+
+    void Close() {
+        if (m_closed) return;
+        m_closed = true;
+        m_api.destroyVector(&m_values);
+        m_values = {};
+    }
+
+private:
+    void CheckOpen() const {
+        if (m_closed) throw std::runtime_error("Retail wide-text arguments are closed");
+    }
+    void* m_game;
+    RetailWideTextAPIs m_api;
+    RetailWideTextVector m_values{};
+    bool m_closed = false;
+};
