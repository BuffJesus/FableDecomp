+    void UpdateOnlineScore(unsigned slot, float score) {
+        CheckOpen();
+        // Dispatch only reviewed original GSI score APIs; their state-dependent
+        // statistics behavior and receiver selection remain inside the engine.
+        if (slot != 0xB58)
+            throw std::runtime_error("Unknown retail online-score API slot");
+        if (!UpdateOnlineScore_ChickenKick_API)
+            throw std::runtime_error("Retail online-score API is unavailable");
+        UpdateOnlineScore_ChickenKick_API(m_game, score);
+    }
