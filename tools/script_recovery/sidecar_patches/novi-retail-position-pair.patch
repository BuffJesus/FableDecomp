--- /dev/null
+++ b/FableScriptExtender/retail_position_pair.h
@@ -0,0 +1,32 @@
+#pragma once
+#include "FableAPI.h"
+#include "EntityScriptingAPI.h"
+#include <stdexcept>
+
+// The second position is borrowed first. Neither snapshot is read until the
+// first Thing's virtual getter has also returned; the callbacks may share or
+// update the underlying position storage. No actor copy or retain is introduced.
+class RetailPositionPair {
+public:
+    struct Snapshot { C3DVector first; C3DVector second; };
+    static Snapshot Read(CScriptThing* first, CScriptThing* second) {
+        auto* firstTable = first ? reinterpret_cast<CScriptThingVTable*>(first->pVTable) : nullptr;
+        if (!firstTable || !firstTable->GetPos)
+            throw std::runtime_error("Retail paired position Thing vtable unavailable");
+        auto* implementation = second ? reinterpret_cast<CGameScriptThing*>(second->pImp.Data) : nullptr;
+        const volatile C3DVector* secondPosition = nullptr;
+        if (implementation) {
+            auto* table = reinterpret_cast<CGameScriptThingVTable*>(implementation->pVTable);
+            if (!table || !table->GetPos)
+                throw std::runtime_error("Retail paired position implementation vtable unavailable");
+            secondPosition = table->GetPos(implementation);
+        } else {
+            secondPosition = ASLR<const volatile C3DVector*>(0x0143E8E0);
+        }
+        if (!secondPosition) throw std::runtime_error("Retail paired position returned a null vector");
+        const volatile C3DVector* firstPosition = firstTable->GetPos(first);
+        if (!firstPosition) throw std::runtime_error("Retail paired position returned a null vector");
+        return {{firstPosition->x, firstPosition->y, firstPosition->z},
+                {secondPosition->x, secondPosition->y, secondPosition->z}};
+    }
+};
