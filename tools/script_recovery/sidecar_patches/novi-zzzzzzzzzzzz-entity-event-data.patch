+    // SendEntityEvent's fourth native argument is a CThing*, obtained from a
+    // retained script handle. Pickpocket's spotted path passes its current target.
+    quest["SendEntityEventWithThingData"] = [](LuaQuestState& self, int eventType,
+        const std::shared_ptr<CScriptThing>& sender, const std::shared_ptr<CScriptThing>& receiver,
+        const std::shared_ptr<CScriptThing>& data) {
+        auto* gsi = self.GetGameInterface();
+        if (!gsi || !SendEntityEvent_API)
+            throw std::runtime_error("SendEntityEventWithThingData API unavailable");
+        CThing* nativeData = nullptr;
+        auto* impl = data ? reinterpret_cast<CGameScriptThing*>(data->pImp.Data) : nullptr;
+        if (impl) {
+            auto* table = reinterpret_cast<CGameScriptThingVTable*>(impl->pVTable);
+            if (!table || !table->GetPThing)
+                throw std::runtime_error("SendEntityEventWithThingData GetPThing unavailable");
+            nativeData = table->GetPThing(impl);
+        }
+        SendEntityEvent_API(gsi, static_cast<NEntityEvents::EEventType>(eventType),
+                            sender.get(), receiver.get(), nativeData);
+    };
