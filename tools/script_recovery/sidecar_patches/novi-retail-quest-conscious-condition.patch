+void LuaQuestState::RegisterQuestConsciousCondition(CScriptThing* actor) {
+    if (!m_pParentHost || m_pParentHost->IsClosing() || !actor)
+        throw std::runtime_error("Conscious condition requires a live quest host and Thing");
+    if (!g_fableBase || !RetailThing_Copy_API || !RetailThing_Destroy_API)
+        throw std::runtime_error("Retail quest condition APIs unavailable");
+    void* active = nullptr;
+    std::memcpy(&active, reinterpret_cast<const char*>(&m_pParentHost->base) + 0x2c, sizeof(active));
+    if (!active)
+        throw std::runtime_error("Quest condition requires an active native thread");
+    struct Condition {
+        void** table;
+        CScriptThing thing{};
+        ~Condition() { RetailThing_Destroy_API(&thing); }
+    } condition{ASLR<void**>(0x012C2FE8)};
+    static_assert(offsetof(Condition, thing) == 4 && sizeof(Condition) == 16, "Retail x86 condition layout");
+    RetailThing_Copy_API(&condition.thing, actor);
+    using Register = void(__thiscall*)(CScriptBase_Retail*, const void*);
+    ASLR<Register>(0x00CB7920)(&m_pParentHost->base, &condition);
+}
