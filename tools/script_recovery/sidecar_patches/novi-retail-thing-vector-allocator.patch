diff --git a/FableScriptExtender/RetailThingVector.h b/FableScriptExtender/RetailThingVector.h
new file mode 100644
index 0000000..ee04638
--- /dev/null
+++ b/FableScriptExtender/RetailThingVector.h
@@ -0,0 +1,75 @@
+#pragma once
+#include "FableAPI.h"
+#include "EntityScriptingAPI.h"
+#include <cstdint>
+#include <exception>
+#include <stdexcept>
+
+struct RetailThingVectorStorage {
+    CScriptThing* begin = nullptr;
+    CScriptThing* end = nullptr;
+    CScriptThing* capacity = nullptr;
+};
+static_assert(sizeof(CScriptThing) == 12 && sizeof(RetailThingVectorStorage) == 12,
+              "Retail Thing vectors require Win32 entries and three pointers");
+
+// The native vector owns its entries. Lua heap copies explicitly retain their
+// own references before this owner retires the originals through vtable slot0
+// with flags0, matching the original8AC970 destructor's12-byte stride.
+class RetailThingVector {
+public:
+    using Destroy = void(*)(CScriptThing*);
+    explicit RetailThingVector(t_free release = Game_free, Destroy destroy = &DestroyNative)
+        : release_(release), destroy_(destroy) {
+        if (!release_ || !destroy_)
+            throw std::runtime_error("Retail Thing vector cleanup unavailable");
+    }
+    ~RetailThingVector() { try { Close(); } catch (...) {} }
+    RetailThingVector(const RetailThingVector&) = delete;
+    RetailThingVector& operator=(const RetailThingVector&) = delete;
+    RetailThingVectorStorage* Output() {
+        if (closed_) throw std::runtime_error("Retail Thing vector is closed");
+        return &storage_;
+    }
+    unsigned int Count() const {
+        if (!storage_.begin) return 0;
+        return static_cast<unsigned int>((reinterpret_cast<std::uintptr_t>(storage_.end)
+            - reinterpret_cast<std::uintptr_t>(storage_.begin)) / sizeof(CScriptThing));
+    }
+    bool Empty() const { return Count() == 0; }
+    const CScriptThing* At(unsigned int index) const {
+        if (closed_ || index >= Count())
+            throw std::runtime_error("Retail Thing vector index out of range");
+        return storage_.begin + index;
+    }
+    void Close() {
+        if (closed_) return;
+        std::exception_ptr failure;
+        const unsigned int count = Count();
+        while (retired_ < count) {
+            auto entry = storage_.begin + retired_++;
+            try { destroy_(entry); }
+            catch (...) { if (!failure) failure = std::current_exception(); }
+        }
+        auto buffer = storage_.begin;
+        storage_ = {};
+        closed_ = true;
+        if (buffer) {
+            try { release_(buffer); }
+            catch (...) { if (!failure) failure = std::current_exception(); }
+        }
+        if (failure) std::rethrow_exception(failure);
+    }
+private:
+    static void DestroyNative(CScriptThing* entry) {
+        auto table = reinterpret_cast<CScriptThingVTable*>(entry->pVTable);
+        if (!table || !table->Destructor)
+            throw std::runtime_error("Retail Thing vector entry has no destructor");
+        table->Destructor(entry, 0);
+    }
+    RetailThingVectorStorage storage_{};
+    t_free release_;
+    Destroy destroy_;
+    unsigned int retired_ = 0;
+    bool closed_ = false;
+};
