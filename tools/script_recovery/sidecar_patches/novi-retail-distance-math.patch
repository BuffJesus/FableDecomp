diff --git a/FableScriptExtender/retail_distance_math.h b/FableScriptExtender/retail_distance_math.h
new file mode 100644
index 0000000..f582fd0
--- /dev/null
+++ b/FableScriptExtender/retail_distance_math.h
@@ -0,0 +1,41 @@
+#pragma once
+#include "FableAPI.h"
+#include "EntityScriptingAPI.h"
+#include <stdexcept>
+
+// Preserve original getter order and the un-narrowed x87 return. A caller's
+// float store is separate from this query, including comparisons before a store.
+class RetailDistanceMath {
+public:
+    using BetweenFunction = double(__fastcall*)(CScriptThing*, CScriptThing*);
+    using PositionFunction = double(__fastcall*)(CScriptThing*, const C3DVector*);
+    struct APIs { BetweenFunction between; PositionFunction position; };
+    static APIs NativeAPIs() {
+        return {ASLR<BetweenFunction>(0x00CBE512), ASLR<PositionFunction>(0x00CBE551)};
+    }
+    explicit RetailDistanceMath(APIs apis = NativeAPIs()) : apis(apis) {}
+    double BetweenThings(CScriptThing* first, CScriptThing* second) const {
+        if (!apis.between) throw std::runtime_error("Retail Thing distance unavailable");
+        CScriptThing empty{};
+        empty.pVTable = g_pCScriptThingVTable;
+        first = first ? first : &empty;
+        second = second ? second : &empty;
+        CheckPositionTable(first);
+        CheckPositionTable(second);
+        return apis.between(first, second);
+    }
+    double FromThingToPosition(CScriptThing* thing, const C3DVector& position) const {
+        if (!apis.position) throw std::runtime_error("Retail Thing/position distance unavailable");
+        CScriptThing empty{};
+        empty.pVTable = g_pCScriptThingVTable;
+        thing = thing ? thing : &empty;
+        CheckPositionTable(thing);
+        return apis.position(thing, &position);
+    }
+private:
+    static void CheckPositionTable(CScriptThing* thing) {
+        auto* table = reinterpret_cast<CScriptThingVTable*>(thing->pVTable);
+        if (!table || !table->GetPos) throw std::runtime_error("Retail Thing position vtable unavailable");
+    }
+    APIs apis;
+};
