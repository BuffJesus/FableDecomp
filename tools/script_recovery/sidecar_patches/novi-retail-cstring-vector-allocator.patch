diff --git a/FableScriptExtender/RetailCStringVector.h b/FableScriptExtender/RetailCStringVector.h
new file mode 100644
index 0000000..05f6fd5
--- /dev/null
+++ b/FableScriptExtender/RetailCStringVector.h
@@ -0,0 +1,72 @@
+#pragma once
+#include "FableAPI.h"
+#include <cstdint>
+#include <exception>
+#include <stdexcept>
+
+// The game fills this STLport layout using MSVCR71 allocation. It is not a
+// modern std::vector and must never be released through the bridge's CRT.
+struct RetailCStringVectorStorage {
+    CCharString* begin = nullptr;
+    CCharString* end = nullptr;
+    CCharString* capacity = nullptr;
+};
+static_assert(sizeof(CCharString) == 4 && sizeof(RetailCStringVectorStorage) == 12,
+              "Retail CString vectors require the Win32 three-pointer layout");
+
+class RetailCStringVector {
+public:
+    explicit RetailCStringVector(tCCharString_Destructor destroy = CCharString_Destroy,
+                                 t_free release = Game_free)
+        : destroy_(destroy), release_(release) {
+        if (!destroy_ || !release_)
+            throw std::runtime_error("Retail CString vector cleanup unavailable");
+    }
+    ~RetailCStringVector() { try { Close(); } catch (...) {} }
+    RetailCStringVector(const RetailCStringVector&) = delete;
+    RetailCStringVector& operator=(const RetailCStringVector&) = delete;
+
+    RetailCStringVectorStorage* Output() {
+        if (closed_) throw std::runtime_error("Retail CString vector is closed");
+        return &storage_;
+    }
+    unsigned int Count() const {
+        if (!storage_.begin) return 0;
+        return static_cast<unsigned int>((reinterpret_cast<std::uintptr_t>(storage_.end)
+            - reinterpret_cast<std::uintptr_t>(storage_.begin)) / sizeof(CCharString));
+    }
+    CCharString* At(unsigned int index) {
+        if (closed_ || index >= Count())
+            throw std::runtime_error("Retail CString vector index out of range");
+        return storage_.begin + index;
+    }
+    void RetireNext() {
+        if (closed_ || retired_ >= Count())
+            throw std::runtime_error("Retail CString vector retirement out of range");
+        // Record retirement before dispatch so an exceptional cleanup cannot
+        // cause a second attempt on the same CString.
+        destroy_(storage_.begin + retired_++);
+    }
+    void Close() {
+        if (closed_) return;
+        std::exception_ptr failure;
+        while (retired_ < Count()) {
+            try { RetireNext(); }
+            catch (...) { if (!failure) failure = std::current_exception(); }
+        }
+        auto buffer = storage_.begin;
+        storage_ = {};
+        closed_ = true;
+        if (buffer) {
+            try { release_(buffer); }
+            catch (...) { if (!failure) failure = std::current_exception(); }
+        }
+        if (failure) std::rethrow_exception(failure);
+    }
+private:
+    RetailCStringVectorStorage storage_{};
+    tCCharString_Destructor destroy_;
+    t_free release_;
+    unsigned int retired_ = 0;
+    bool closed_ = false;
+};
