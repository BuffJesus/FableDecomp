new file mode 100644
index 0000000..c5a3da8
--- /dev/null
+++ b/FableScriptExtender/DirectThingImplementationEquality.h
@@ -0,0 +1,11 @@
+#pragma once
+
+// Scratch ABI candidate for native calls that load CScriptThing.Data and invoke
+// the concrete implementation vtable directly. Both arguments must be actual
+// 12-byte wrappers, including owned empty wrappers. No nil-safe substitution:
+// empty Data retains the native invalid-dereference behavior.
+inline bool DirectThingImplementationEquality(CScriptThing* lhs, const CScriptThing* rhs) {
+    auto* implementation = reinterpret_cast<CGameScriptThing*>(lhs->pImp.Data);
+    auto* table = reinterpret_cast<CGameScriptThingVTable*>(implementation->pVTable);
+    return table->IsEqualTo(implementation, reinterpret_cast<const CScriptThing*>(rhs->pImp.Data));
+}
