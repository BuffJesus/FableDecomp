diff --git a/FableScriptExtender/RetailThingOutputOwner.h b/FableScriptExtender/RetailThingOutputOwner.h
new file mode 100644
index 0000000..b43187e
--- /dev/null
+++ b/FableScriptExtender/RetailThingOutputOwner.h
@@ -0,0 +1,72 @@
+#pragma once
+#include <functional>
+#include <map>
+#include <memory>
+#include <stdexcept>
+
+// Host metadata owns one native reference independently of Lua aliases.
+// Registry operations belong to the existing single-threaded script host.
+class RetailThingOutputOwner {
+public:
+    using Cleanup = std::function<void(CScriptThing*)>;
+    RetailThingOutputOwner(CScriptThing* thing, Cleanup destroy, Cleanup freeBuffer)
+        : m_thing(thing), m_destroy(std::move(destroy)), m_free(std::move(freeBuffer)) {}
+    ~RetailThingOutputOwner() noexcept {
+        // Publication may fail while creating the registry itself. An owner
+        // not yet registered must never try to initialize it during cleanup.
+        if (m_registered) {
+            auto& registry = Registry();
+            auto found = registry.find(m_thing);
+            if (found != registry.end()) registry.erase(found);
+        }
+        Retire();
+        m_free(m_thing);
+    }
+    RetailThingOutputOwner(const RetailThingOutputOwner&) = delete;
+    RetailThingOutputOwner& operator=(const RetailThingOutputOwner&) = delete;
+    void Retire() noexcept {
+        if (m_retired) return;
+        m_retired = true;
+        auto* emptyTable = m_thing->pVTable;
+        m_destroy(m_thing);
+        // Retail scalar destruction installs the base-object vtable. Lua aliases
+        // remain CScriptThing userdata and must retain callable empty-Thing slots.
+        m_thing->pImp.Data = nullptr;
+        m_thing->pImp.Info = nullptr;
+        m_thing->pVTable = emptyTable;
+    }
+    bool Retired() const noexcept { return m_retired; }
+    CScriptThing* Thing() const noexcept { return m_thing; }
+    void Claim(const void* scope) {
+        if (!scope || m_retired || (m_scope && m_scope != scope))
+            throw std::runtime_error("Thing output is retired or belongs to another scope");
+        m_scope = scope;
+    }
+    static std::shared_ptr<RetailThingOutputOwner> Find(CScriptThing* thing) {
+        auto& registry = Registry();
+        auto found = registry.find(thing);
+        return found == registry.end() ? nullptr : found->second.lock();
+    }
+    static std::shared_ptr<CScriptThing> Publish(
+        const std::shared_ptr<RetailThingOutputOwner>& owner) {
+        auto& registry = Registry();
+        if (registry.find(owner->m_thing) != registry.end())
+            throw std::runtime_error("Thing output already registered");
+        registry.emplace(owner->m_thing, owner);
+        owner->m_registered = true;
+        return std::shared_ptr<CScriptThing>(owner, owner->m_thing);
+    }
+private:
+    static std::map<CScriptThing*, std::weak_ptr<RetailThingOutputOwner>>& Registry() {
+        // Lua states can finalize during static teardown; keep this process-wide
+        // index alive, while each owner removes its entry on destruction.
+        static auto* registry = new std::map<CScriptThing*, std::weak_ptr<RetailThingOutputOwner>>;
+        return *registry;
+    }
+    CScriptThing* m_thing;
+    Cleanup m_destroy;
+    Cleanup m_free;
+    bool m_retired = false;
+    bool m_registered = false;
+    const void* m_scope = nullptr;
+};
diff --git a/FableScriptExtender/retail_thing_position_list.h b/FableScriptExtender/retail_thing_position_list.h
new file mode 100644
index 0000000..c165283
--- /dev/null
+++ b/FableScriptExtender/retail_thing_position_list.h
@@ -0,0 +1,64 @@
+#pragma once
+// Generic retained retail Thing vector; only positions cross into Lua.
+#include "FableAPI.h"
+#include "GameInterface.h"
+#include <cstdint>
+#include <stdexcept>
+
+class RetailThingPositionList {
+public:
+    struct Vector { CScriptThing* begin=nullptr; CScriptThing* end=nullptr; CScriptThing* capacity=nullptr; };
+    static_assert(sizeof(Vector)==12 && sizeof(CScriptThing)==12,"Retail Thing vectors require x86");
+    using Getter=int(__thiscall*)(CGameScriptInterfaceBase*,const CCharString*,Vector*);
+    using Erase=CScriptThing*(__thiscall*)(Vector*,CScriptThing*,CScriptThing*);
+    using Destroy=void(__thiscall*)(Vector*);
+    struct APIs { Getter get; Erase erase; Destroy destroy; };
+    static APIs NativeAPIs() {
+        return {reinterpret_cast<Getter>(GetAllThingsWithScriptName_API),
+                ASLR<Erase>(0x008AC9D0),ASLR<Destroy>(0x008AC970)};
+    }
+    explicit RetailThingPositionList(CGameScriptInterfaceBase* game,APIs apis=NativeAPIs()):game(game),apis(apis) {
+        if(!game || !apis.get || !apis.erase || !apis.destroy || !CCharString_Construct_Literal || !CCharString_Destroy)
+            throw std::runtime_error("Retail Thing position list APIs unavailable");
+    }
+    RetailThingPositionList(const RetailThingPositionList&)=delete;
+    RetailThingPositionList& operator=(const RetailThingPositionList&)=delete;
+    ~RetailThingPositionList(){try {Close();}catch(...) {}}
+    void Clear() {
+        CheckOpen();
+        apis.erase(&vector,vector.begin,vector.end);
+    }
+    int FillScriptName(const std::string& name) {
+        CheckOpen();
+        CCharString key{};
+        CCharString_Construct_Literal(&key,name.c_str(),-1);
+        int result;
+        try {result=apis.get(game,&key,&vector);}
+        catch(...) {try {CCharString_Destroy(&key);}catch(...) {} throw;}
+        CCharString_Destroy(&key);
+        return result;
+    }
+    int Count() const {
+        CheckOpen();
+        auto bytes=static_cast<std::int32_t>(reinterpret_cast<std::uintptr_t>(vector.end)-reinterpret_cast<std::uintptr_t>(vector.begin));
+        return bytes/12;
+    }
+    // Binding consumes this borrowed pointer immediately through native GetPos.
+    // It must never expose an actor userdata or retain a separate actor copy.
+    CScriptThing* PositionSource(int index) {
+        CheckOpen();
+        if(index<0 || index>=Count())throw std::out_of_range("Retail Thing position list index");
+        return vector.begin+index;
+    }
+    void Close() {
+        if(closed)return;
+        closed=true;
+        apis.destroy(&vector);
+    }
+private:
+    void CheckOpen() const {if(closed)throw std::runtime_error("Retail Thing position list is closed");}
+    CGameScriptInterfaceBase* game;
+    APIs apis;
+    Vector vector{};
+    bool closed=false;
+};
