diff --git a/FableScriptExtender/retail_float_math.h b/FableScriptExtender/retail_float_math.h
new file mode 100644
index 0000000..954f52e
--- /dev/null
+++ b/FableScriptExtender/retail_float_math.h
@@ -0,0 +1,70 @@
+#pragma once
+#include "FableAPI.h"
+#include "EntityScriptingAPI.h"
+#include <stdexcept>
+
+// Retail float-vector operations and x87 angle boundaries. These preserve the
+// caller's FPU control word; they do not promise equivalence under a changed mode.
+class RetailFloatMath {
+public:
+    using NormalizeFunction = void(__thiscall*)(C3DVector*);
+    using RotateFunction = void(__thiscall*)(C3DVector*, const C3DVector*, float);
+    // _CIacos receives and returns its operand on the x87 stack.
+    using ArcCosFunction = void(__cdecl*)();
+    struct APIs {
+        NormalizeFunction normalize;
+        RotateFunction rotate;
+        ArcCosFunction arcCos;
+    };
+    static APIs NativeAPIs() {
+        return {ASLR<NormalizeFunction>(0x00A14440),
+                ASLR<RotateFunction>(0x00A13C60),
+                ASLR<ArcCosFunction>(0x00BFEBA2)};
+    }
+    explicit RetailFloatMath(APIs apis = NativeAPIs()) : apis(apis) {}
+    C3DVector Normalize(C3DVector value) const {
+        if (!apis.normalize) throw std::runtime_error("Retail vector normalization unavailable");
+        apis.normalize(&value);
+        return value;
+    }
+    C3DVector Rotate(C3DVector value, const C3DVector& axis, float turns) const {
+        if (!apis.rotate) throw std::runtime_error("Retail vector rotation unavailable");
+        apis.rotate(&value, &axis, turns);
+        return value;
+    }
+    float ArcCosTurns(float value, float fraction) const {
+        if (!apis.arcCos) throw std::runtime_error("Retail arc cosine unavailable");
+        auto nativeArcCos = apis.arcCos;
+        // Original retail float reciprocal of 2*pi, followed by the requested
+        // fraction, with a single float store after both multiplications.
+        const float turnsPerRadian = 0.15915493667125702f;
+        float result;
+        __asm {
+            fld value
+            call nativeArcCos
+            fmul turnsPerRadian
+            fmul fraction
+            fstp result
+        }
+        return result;
+    }
+    bool CosTurnsLessThan(float turns, double threshold) const {
+        const double radiansPerTurn = 6.2831854820251465;
+        bool result;
+        // Compare before narrowing the transcendental result to a Lua double.
+        // TEST AH,5 / SETNP accepts strictly less; equal and unordered are false.
+        __asm {
+            fld threshold
+            fld turns
+            fmul radiansPerTurn
+            fcos
+            fcompp
+            fnstsw ax
+            test ah, 5
+            setnp result
+        }
+        return result;
+    }
+private:
+    APIs apis;
+};
