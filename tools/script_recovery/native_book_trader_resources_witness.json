  "resourceOffset": 20,
  "semantics": {
    "presence": "resource.pImp.Data != null, independent of acquire return",
    "reset": "release pImp reference and zero pointer and refcount metadata",
    "success": "StartScriptingEntity installs scripted resource via8AB960 then returns true",
    "failure": "early false path may leave resource unchanged; fallback path installs903810 resource via8ABD10 then returns false",
    "runtimeGap": "AcquireControl retries internally and destroys its handle on termination; its return boolean does not model native resource presence or per-attempt scheduling",
    "requiredRecovery": "Preserve resource identity and resets across priority3/4; prove fallback/failed acquisition semantics before lowering presence and destruction"
  },
  "review": "One stack20 resource, eight self acquisitions, four conditional resets, two out-of-line actor destructors plus two inline reference-counted exit cleanups DB4E7B/DB4EC6 (not mapped as destructor calls). Native DB89B715..89B76D fallback assigns then returnsfalse. Do not equate has_resource with acquisition success.",
  "sharedDestructorReceiver": {
    "site": "0xDB4F5A",
    "resourceOffset": 20,
    "selectionSites": [
      "0xDB41A1",
      "0xDB4555",
      "0xDB4F56"
    ],
    "review": "Two conditional direct entries have LEA ECX,[ESP+14] immediately before their JNE. Fallthrough entry selects ECX atDB4F56. Linear call-window intentionally reports incoming ECX, not an invented stack value."
  }
